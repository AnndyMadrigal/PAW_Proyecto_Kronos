@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Finanzas"; }
<div class="space-y-6" x-data="financialModule()" x-init="load()">
 <div class="flex items-center justify-between"><div><h1 class="text-2xl font-semibold text-gray-800 dark:text-white">Control financiero</h1><p class="mt-1 text-sm text-gray-500">Ingresos, gastos y saldo disponible.</p></div><button @@click="showForm=true" class="rounded-lg bg-brand-500 px-4 py-2 text-sm text-white">Registrar movimiento</button></div>
 <div class="grid gap-4 sm:grid-cols-3"><template x-for="card in [{n:'Ingresos',v:summary.total_income,c:'text-emerald-600'},{n:'Gastos',v:summary.total_expense,c:'text-red-600'},{n:'Saldo',v:summary.balance,c:'text-brand-600'}]"><div class="rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[.03]"><p class="text-sm text-gray-500" x-text="card.n"></p><p class="mt-2 text-2xl font-semibold" :class="card.c" x-text="money(card.v)"></p></div></template></div>
 <p x-show="message" class="text-sm text-red-600" x-text="message"></p>
 <section class="rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[.03]"><div class="mb-4 flex gap-2"><input type="date" x-model="from" class="rounded border p-2"><input type="date" x-model="to" class="rounded border p-2"><button @@click="transactions()" class="rounded border px-3">Filtrar</button></div><table class="min-w-full text-sm"><thead><tr class="border-b text-left"><th class="p-2">Fecha</th><th class="p-2">Tipo</th><th class="p-2">Categoría</th><th class="p-2">Descripción</th><th class="p-2 text-right">Monto</th></tr></thead><tbody><template x-for="item in items" :key="item.id"><tr class="border-b"><td class="p-2" x-text="new Date(item.transaction_date).toLocaleDateString('es-CR')"></td><td class="p-2" x-text="item.transaction_type==='income'?'Ingreso':'Gasto'"></td><td class="p-2" x-text="item.category_name"></td><td class="p-2" x-text="item.description||'—'"></td><td class="p-2 text-right" x-text="money(item.amount)"></td></tr></template></tbody></table></section>
 <div x-show="showForm" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-gray-950/50 p-4" @@keydown.escape.window="showForm=false"><div @@click.outside="showForm=false" class="w-full max-w-3xl rounded-2xl bg-white p-6 shadow-xl dark:bg-gray-900"><div class="flex justify-between"><div><h2 class="text-lg font-semibold dark:text-white">Registrar movimiento</h2><p class="text-sm text-gray-500">Selecciona la categoría y el método de pago.</p></div><button @@click="showForm=false" class="text-xl text-gray-500">×</button></div><form @@submit.prevent="save()" class="mt-5 grid gap-3 md:grid-cols-3"><div><label class="mb-1 block text-sm font-medium">Tipo</label><select x-model="form.transaction_type" @@change="form.financial_category_id=null" class="w-full rounded border p-2"><option value="income">Ingreso</option><option value="expense">Gasto</option></select></div><div><label class="mb-1 block text-sm font-medium">Categoría</label><select required x-model.number="form.financial_category_id" class="w-full rounded border p-2"><option value="">Seleccione una categoría</option><template x-for="category in filteredCategories()" :key="category.id"><option :value="category.id" x-text="category.name"></option></template></select></div><div><label class="mb-1 block text-sm font-medium">Método de pago</label><select x-model.number="form.financial_payment_method_id" class="w-full rounded border p-2"><option value="">No especificado</option><template x-for="method in references.payment_methods" :key="method.id"><option :value="method.id" x-text="method.name"></option></template></select></div><div><label class="mb-1 block text-sm font-medium">Monto</label><input required min=".01" step=".01" type="number" x-model.number="form.amount" class="w-full rounded border p-2"></div><div><label class="mb-1 block text-sm font-medium">Fecha y hora</label><input required type="datetime-local" x-model="form.transaction_date" class="w-full rounded border p-2"></div><div><label class="mb-1 block text-sm font-medium">Descripción</label><input x-model="form.description" class="w-full rounded border p-2"></div><div class="md:col-span-3 flex justify-end gap-3"><button type="button" @@click="showForm=false" class="rounded border px-4 py-2">Cancelar</button><button class="rounded bg-brand-500 px-4 py-2 text-white">Guardar movimiento</button></div></form></div></div>
</div>
@section Scripts {<script>function financialModule(){const base='@Configuration["Valores:UrlApi"]Financial/',h={'Content-Type':'application/json','Authorization':'Bearer @Context.Session.GetString("Token")'},newForm=()=>({transaction_type:'income',financial_category_id:null,financial_payment_method_id:null,amount:null,transaction_date:new Date().toISOString().slice(0,16),description:''});return{summary:{},items:[],references:{categories:[],payment_methods:[]},showForm:false,message:'',from:'',to:'',form:newForm(),money:v=>new Intl.NumberFormat('es-CR',{style:'currency',currency:'CRC'}).format(v||0),filteredCategories(){return this.references.categories.filter(c=>c.transaction_type===this.form.transaction_type)},async load(){await Promise.all([this.summaryLoad(),this.transactions(),this.loadReferences()])},async loadReferences(){let r=await fetch(base+'References',{headers:h});if(r.ok)this.references=await r.json();else this.message=await r.text()},async summaryLoad(){let r=await fetch(base+'Summary',{headers:h});if(r.ok)this.summary=await r.json()},async transactions(){let q='Transactions'+((this.from||this.to)?'?from='+this.from+'&to='+this.to:'');let r=await fetch(base+q,{headers:h});if(r.ok)this.items=await r.json();else this.message=await r.text()},async save(){let p={...this.form,financial_payment_method_id:this.form.financial_payment_method_id||null,transaction_date:new Date(this.form.transaction_date).toISOString()},r=await fetch(base+'Transactions',{method:'POST',headers:h,body:JSON.stringify(p)});if(!r.ok){this.message=await r.text();return}this.showForm=false;this.form=newForm();await this.load()}}}</script>}
