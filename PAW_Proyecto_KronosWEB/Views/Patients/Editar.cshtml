@model int
@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Editar paciente"; }
<div class="mx-auto max-w-3xl" x-data="patientEdit()" x-init="load()">
    <div class="mb-6"><h1 class="text-2xl font-semibold text-gray-800 dark:text-white">Editar paciente</h1><p class="mt-1 text-sm text-gray-500">Actualiza los datos de la persona atendida.</p></div>
    <p x-show="message" x-text="message" class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700"></p>
    <form x-show="loaded" @@submit.prevent="save()" class="grid gap-4 rounded-2xl border border-gray-200 bg-white p-6 sm:grid-cols-2 dark:border-gray-800 dark:bg-white/[.03]"><label class="text-sm dark:text-gray-300">Nombre<input required x-model.trim="form.first_name" class="mt-1 w-full rounded-lg border p-2 dark:bg-gray-800"></label><label class="text-sm dark:text-gray-300">Apellido<input required x-model.trim="form.last_name" class="mt-1 w-full rounded-lg border p-2 dark:bg-gray-800"></label><label class="text-sm dark:text-gray-300">Identificación<input x-model.trim="form.identification_number" class="mt-1 w-full rounded-lg border p-2 dark:bg-gray-800"></label><label class="text-sm dark:text-gray-300">Fecha de nacimiento<input type="date" x-model="form.birth_date" class="mt-1 w-full rounded-lg border p-2 dark:bg-gray-800"></label><label class="text-sm dark:text-gray-300">Teléfono<input x-model.trim="form.phone" class="mt-1 w-full rounded-lg border p-2 dark:bg-gray-800"></label><label class="text-sm dark:text-gray-300">Correo electrónico<input type="email" x-model.trim="form.email" class="mt-1 w-full rounded-lg border p-2 dark:bg-gray-800"></label><div class="sm:col-span-2 flex justify-end gap-3 pt-2"><a asp-action="Index" class="rounded-lg border px-4 py-2 text-sm">Cancelar</a><button class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white">Guardar cambios</button></div></form>
</div>
@section Scripts { <script>function patientEdit(){const id=@Model,base='@Configuration["Valores:UrlApi"]Patients',headers={'Content-Type':'application/json','Authorization':'Bearer @Context.Session.GetString("Token")'};return{loaded:false,message:'',form:{},async load(){const r=await fetch(base+'/'+id,{headers});if(!r.ok){this.message='No fue posible cargar los datos del paciente.';return}const p=await r.json();this.form={...p,birth_date:p.birth_date?p.birth_date.slice(0,10):''};this.loaded=true},async save(){this.message='';const r=await fetch(base+'/'+id,{method:'PUT',headers,body:JSON.stringify(this.form)});if(!r.ok){this.message=await r.text()||'No fue posible guardar el paciente.';return}window.location.href='@Url.Action("Index", "Patients")'}}}</script> }
