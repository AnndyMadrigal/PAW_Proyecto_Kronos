@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Pacientes"; }
<div class="space-y-6" x-data="patientsList()" x-init="load()">
    <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center"><div><h1 class="text-2xl font-semibold text-gray-800 dark:text-white">Pacientes</h1><p class="mt-1 text-sm text-gray-500">Registro y consulta de las personas atendidas por la Asociación.</p></div><a asp-action="Crear" class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white">Registrar paciente</a></div>
    <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[.03]"><div class="flex flex-col gap-3 sm:flex-row"><input x-model="search" @@keyup.enter="load()" placeholder="Buscar por nombre, apellido o identificación" class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white"><button @@click="load()" class="rounded-lg border border-gray-300 px-4 py-2 text-sm dark:border-gray-700 dark:text-gray-200">Buscar</button></div></div>
    <p x-show="message" x-text="message" class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700"></p>
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[.03]"><div x-show="loading" class="p-6 text-center text-sm text-gray-500">Cargando pacientes…</div><div x-show="!loading && items.length === 0" class="p-6 text-center text-sm text-gray-500">No hay pacientes que coincidan con la búsqueda.</div><div x-show="!loading && items.length > 0" class="overflow-x-auto"><table class="min-w-full text-sm"><thead class="border-b border-gray-200 text-left text-xs uppercase text-gray-500 dark:border-gray-800"><tr><th class="px-4 py-3">Paciente</th><th class="px-4 py-3">Identificación</th><th class="px-4 py-3">Contacto</th><th class="px-4 py-3 text-right">Acciones</th></tr></thead><tbody><template x-for="patient in items" :key="patient.id"><tr class="border-b border-gray-100 last:border-0 dark:border-gray-800"><td class="px-4 py-3 font-medium text-gray-800 dark:text-white" x-text="patient.first_name + ' ' + patient.last_name"></td><td class="px-4 py-3 text-gray-500" x-text="patient.identification_number || '—'"></td><td class="px-4 py-3 text-gray-500"><span x-text="patient.phone || '—'"></span><span x-show="patient.email" class="block text-xs" x-text="patient.email"></span></td><td class="px-4 py-3 text-right"><a :href="'@Url.Action("Editar", "Patients")/' + patient.id" class="text-sm font-medium text-brand-500">Editar</a></td></tr></template></tbody></table></div></div>
</div>
@section Scripts { <script>function patientsList(){const base='@Configuration["Valores:UrlApi"]Patients',headers={'Authorization':'Bearer @Context.Session.GetString("Token")'};return{items:[],search:'',loading:true,message:'',async load(){this.loading=true;this.message='';const r=await fetch(base+(this.search?'?search='+encodeURIComponent(this.search):''),{headers});if(r.ok)this.items=await r.json();else this.message='No fue posible cargar los pacientes.';this.loading=false}}}</script> }
