@inject IConfiguration Configuration
@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio";
}

<div class="p-6" x-data="homeModule()" x-init="load()">
    <section class="rounded-2xl bg-brand-500 p-6 text-white shadow-theme-sm">
        <div class="flex flex-col gap-6 xl:flex-row xl:items-center xl:justify-between">
            <div class="max-w-3xl">
                <p class="text-sm font-medium text-white/75">Asociación de Cuidados Paliativos</p>
                <h1 class="mt-2 text-2xl font-semibold">Kronos: atención y gestión en un solo lugar</h1>
                <p class="mt-3 text-sm leading-6 text-white/85">
                    Organiza la atención de pacientes, las citas, los expedientes, los recursos y la gestión administrativa
                    de la Asociación para que el equipo pueda dar seguimiento oportuno a cada necesidad.
                </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row">
                <a asp-controller="Citas" asp-action="Agenda"
                   class="inline-flex items-center justify-center rounded-lg bg-white px-4 py-2.5 text-sm font-medium text-brand-600 shadow-theme-xs hover:bg-gray-50">
                    Ver agenda de hoy
                </a>
                <a asp-controller="Citas" asp-action="Crear"
                   class="inline-flex items-center justify-center rounded-lg border border-white/50 px-4 py-2.5 text-sm font-medium text-white hover:bg-white/10">
                    Registrar cita
                </a>
            </div>
        </div>
    </section>

    <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white/90">Panorama operativo</h2>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Información actual obtenida de los módulos de citas, finanzas e inventario.</p>
        </div>
        <p x-show="loading" class="text-sm text-gray-500 dark:text-gray-400">Actualizando información…</p>
    </div>
    <p x-show="error" x-text="error" class="mt-4 rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-sm text-orange-700 dark:border-orange-500/30 dark:bg-orange-500/10 dark:text-orange-300"></p>

    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <p class="text-sm text-gray-500 dark:text-gray-400">Citas programadas</p>
            <p class="mt-2 text-2xl font-bold text-gray-800 dark:text-white/90" x-text="appointments.scheduled ?? '—'"></p>
            <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">De <span x-text="appointments.total ?? 0"></span> citas registradas.</p>
        </article>
        <article class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <p class="text-sm text-gray-500 dark:text-gray-400">Citas completadas</p>
            <p class="mt-2 text-2xl font-bold text-gray-800 dark:text-white/90" x-text="appointments.completed ?? '—'"></p>
            <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">Atenciones marcadas como realizadas.</p>
        </article>
        <article class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <p class="text-sm text-gray-500 dark:text-gray-400">Balance financiero</p>
            <p class="mt-2 text-2xl font-bold text-gray-800 dark:text-white/90" x-text="money(financial.balance)"></p>
            <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">Ingresos menos gastos registrados.</p>
        </article>
        <article class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <p class="text-sm text-gray-500 dark:text-gray-400">Insumos con stock bajo</p>
            <p class="mt-2 text-2xl font-bold text-gray-800 dark:text-white/90" x-text="lowStock.length"></p>
            <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">Productos que requieren revisión de abastecimiento.</p>
        </article>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-3">
        <section class="xl:col-span-2 rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white/90">¿Qué necesita gestionar?</h2>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Accesos a las áreas que respaldan la atención paliativa y la operación de la Asociación.</p>

            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <a asp-controller="Citas" asp-action="Index" class="rounded-xl border border-gray-200 p-4 transition hover:border-brand-300 hover:bg-brand-50/40 dark:border-gray-800 dark:hover:border-brand-500/40 dark:hover:bg-brand-500/5">
                    <h3 class="font-semibold text-gray-800 dark:text-white/90">Agenda y citas</h3>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Planifique visitas, consulte el calendario y dé seguimiento a las atenciones programadas.</p>
                </a>
                <a asp-controller="Services" asp-action="Index" class="rounded-xl border border-gray-200 p-4 transition hover:border-brand-300 hover:bg-brand-50/40 dark:border-gray-800 dark:hover:border-brand-500/40 dark:hover:bg-brand-500/5">
                    <h3 class="font-semibold text-gray-800 dark:text-white/90">Atención y expedientes</h3>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Registre y consulte la información que respalda el cuidado de cada paciente.</p>
                </a>
                <a asp-controller="Home" asp-action="Inventory" class="rounded-xl border border-gray-200 p-4 transition hover:border-brand-300 hover:bg-brand-50/40 dark:border-gray-800 dark:hover:border-brand-500/40 dark:hover:bg-brand-500/5">
                    <h3 class="font-semibold text-gray-800 dark:text-white/90">Insumos e inventario</h3>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Controle existencias, entradas, salidas y necesidades de reposición.</p>
                </a>
                <a asp-controller="Financial" asp-action="Index" class="rounded-xl border border-gray-200 p-4 transition hover:border-brand-300 hover:bg-brand-50/40 dark:border-gray-800 dark:hover:border-brand-500/40 dark:hover:bg-brand-500/5">
                    <h3 class="font-semibold text-gray-800 dark:text-white/90">Gestión financiera</h3>
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Registre ingresos y gastos para apoyar el control administrativo de la Asociación.</p>
                </a>
            </div>
        </section>

        <aside class="space-y-6">
            <section class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h2 class="text-lg font-semibold text-gray-800 dark:text-white/90">Atención prioritaria</h2>
                        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Alertas reales de inventario para revisar antes de afectar una atención.</p>
                    </div>
                    <a asp-controller="Home" asp-action="Inventory" class="text-sm font-medium text-brand-500 hover:text-brand-600">Ver inventario</a>
                </div>
                <div class="mt-5 space-y-3" x-show="!loading">
                    <template x-if="lowStock.length === 0 && expiringBatches.length === 0">
                        <p class="rounded-xl bg-green-50 p-4 text-sm text-green-700 dark:bg-green-500/10 dark:text-green-300">No hay alertas de inventario pendientes.</p>
                    </template>
                    <template x-if="lowStock.length > 0">
                        <div class="rounded-xl border border-orange-200 bg-orange-50 p-4 dark:border-orange-500/20 dark:bg-orange-500/10">
                            <p class="text-sm font-medium text-orange-700 dark:text-orange-300">Stock por debajo del mínimo</p>
                            <p class="mt-1 text-sm text-orange-600 dark:text-orange-200"><span x-text="lowStock.length"></span> insumo(s) requieren reposición o revisión.</p>
                        </div>
                    </template>
                    <template x-if="expiringBatches.length > 0">
                        <div class="rounded-xl border border-red-200 bg-red-50 p-4 dark:border-red-500/20 dark:bg-red-500/10">
                            <p class="text-sm font-medium text-red-700 dark:text-red-300">Lotes próximos a vencer</p>
                            <p class="mt-1 text-sm text-red-600 dark:text-red-200"><span x-text="expiringBatches.length"></span> lote(s) vencen en los próximos 30 días.</p>
                        </div>
                    </template>
                </div>
            </section>

            <section class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
                <h2 class="text-lg font-semibold text-gray-800 dark:text-white/90">Resumen financiero</h2>
                <dl class="mt-4 space-y-3 text-sm">
                    <div class="flex items-center justify-between gap-4"><dt class="text-gray-500 dark:text-gray-400">Ingresos</dt><dd class="font-medium text-gray-800 dark:text-white/90" x-text="money(financial.total_income)"></dd></div>
                    <div class="flex items-center justify-between gap-4"><dt class="text-gray-500 dark:text-gray-400">Gastos</dt><dd class="font-medium text-gray-800 dark:text-white/90" x-text="money(financial.total_expense)"></dd></div>
                    <div class="flex items-center justify-between gap-4 border-t border-gray-100 pt-3 dark:border-gray-800"><dt class="font-medium text-gray-700 dark:text-gray-300">Balance</dt><dd class="font-semibold text-brand-600 dark:text-brand-400" x-text="money(financial.balance)"></dd></div>
                </dl>
                <a asp-controller="Financial" asp-action="Index" class="mt-5 inline-flex text-sm font-medium text-brand-500 hover:text-brand-600">Ir a finanzas</a>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        function homeModule() {
            const base = '@Configuration["Valores:UrlApi"]';
            const headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer @Context.Session.GetString("Token")' };
            return {
                appointments: { scheduled: 0, completed: 0, cancelled: 0, total: 0 },
                financial: { total_income: 0, total_expense: 0, balance: 0 },
                lowStock: [],
                expiringBatches: [],
                loading: true,
                error: '',
                money(value) { return new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC' }).format(value || 0); },
                async request(path) {
                    const response = await fetch(base + path, { headers });
                    if (!response.ok) throw new Error();
                    return response.json();
                },
                async load() {
                    this.loading = true;
                    const results = await Promise.allSettled([
                        this.request('Reporting/Appointments/Summary'),
                        this.request('Financial/Summary'),
                        this.request('Inventory/LowStock'),
                        this.request('Inventory/ExpiringBatches?days=30')
                    ]);
                    if (results[0].status === 'fulfilled') this.appointments = results[0].value;
                    if (results[1].status === 'fulfilled') this.financial = results[1].value;
                    if (results[2].status === 'fulfilled') this.lowStock = results[2].value;
                    if (results[3].status === 'fulfilled') this.expiringBatches = results[3].value;
                    if (results.some(result => result.status === 'rejected')) this.error = 'Parte del resumen no pudo actualizarse. Puedes continuar utilizando los módulos del sistema.';
                    this.loading = false;
                }
            };
        }
    </script>
}
