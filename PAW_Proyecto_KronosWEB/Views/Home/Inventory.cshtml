@inject IConfiguration Configuration
@{
    Layout = "_Layout";
    ViewData["Title"] = "Inventario";
}

<div class="p-6">
    <!-- Header -->
    <div class="mb-6 flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-gray-800 dark:text-white/90">
                Inventario de insumos
            </h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                Listado completo de todos los productos disponibles en el inventario.
            </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
            <input type="text" id="searchInput" placeholder="Buscar producto..."
                   class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-700 placeholder-gray-400 shadow-theme-xs focus:border-brand-500 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:placeholder-gray-500">

            <!-- Filtro por categoría -->
            <select id="categoryFilter"
                    class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-700 shadow-theme-xs focus:border-brand-500 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                <option value="">Todas las categorías</option>
            </select>

            <button id="btnNewProduct" type="button"
               class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600">
                Nuevo producto
            </button>
        </div>
    </div>

    <!-- Inventory Table -->
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead>
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Producto</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Descripción</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Categoría</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Stock mínimo</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Estado</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Acciones</th>
                    </tr>
                </thead>
                <tbody id="inventoryTableBody" class="divide-y divide-gray-100 dark:divide-gray-800">
                    <tr>
                        <td colspan="6" class="px-4 py-8">
                            <div class="flex items-center justify-center">
                                <p class="text-sm text-gray-500 dark:text-gray-400">Cargando inventario...</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <div class="mt-6 flex items-center justify-between rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-sm text-gray-600 dark:text-gray-400">
            Mostrando <span id="itemCount">0</span> de <span id="totalCount">0</span> productos
        </p>
        <div class="flex gap-2">
            <button id="btnPrevious" type="button"
                    class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-white/[0.03]">
                Anterior
            </button>
            <button id="btnNext" type="button"
                    class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-white/[0.03]">
                Siguiente
            </button>
        </div>
    </div>
</div>

<!-- ================= MODALES CON ESTILOS INLINE (no dependen de Tailwind) ================= -->

<!-- Modal para agregar nuevo producto -->
<div id="newProductModal" style="display:none; position:fixed; inset:0; z-index:99999; background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
    <div style="width:100%; max-width:28rem; border-radius:1rem; background:#fff; padding:1.5rem; box-shadow:0 10px 25px rgba(0,0,0,0.2); max-height:90vh; overflow-y:auto;">
        <div style="margin-bottom:1rem; display:flex; align-items:center; justify-content:space-between;">
            <h2 style="font-size:1.25rem; font-weight:600; color:#1f2937;">Nuevo Producto</h2>
            <button id="closeNewProductBtn" type="button" style="background:none; border:none; cursor:pointer; color:#9ca3af; font-size:1.5rem; line-height:1;">&times;</button>
        </div>
        <form id="newProductForm">
            <div style="margin-bottom:1rem;">
                <label for="productName" style="display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.5rem;">Nombre del producto *</label>
                <input type="text" id="productName" required placeholder="Ej: Guantes de nitrilo"
                       style="width:100%; border-radius:0.5rem; border:1px solid #d1d5db; padding:0.625rem 1rem; font-size:0.875rem; color:#374151;">
            </div>
            <div style="margin-bottom:1rem;">
                <label for="productDescription" style="display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.5rem;">Descripción</label>
                <textarea id="productDescription" rows="3" placeholder="Ej: Guantes de nitrilo estériles"
                          style="width:100%; border-radius:0.5rem; border:1px solid #d1d5db; padding:0.625rem 1rem; font-size:0.875rem; color:#374151;"></textarea>
            </div>
            <div style="margin-bottom:1rem;">
                <label for="productCategory" style="display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.5rem;">Categoría *</label>
                <select id="productCategory" required
                        style="width:100%; border-radius:0.5rem; border:1px solid #d1d5db; padding:0.625rem 1rem; font-size:0.875rem; color:#374151; background:#fff;">
                    <option value="">Selecciona una categoría...</option>
                </select>
            </div>
            <div style="margin-bottom:1rem;">
                <label for="productUnit" style="display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.5rem;">Unidad *</label>
                <select id="productUnit" required
                        style="width:100%; border-radius:0.5rem; border:1px solid #d1d5db; padding:0.625rem 1rem; font-size:0.875rem; color:#374151; background:#fff;">
                    <option value="">Selecciona una unidad...</option>
                </select>
            </div>
            <div style="margin-bottom:1.5rem;">
                <label for="productMinimumStock" style="display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.5rem;">Stock mínimo *</label>
                <input type="number" id="productMinimumStock" required min="0" step="0.01" placeholder="Ej: 50"
                       style="width:100%; border-radius:0.5rem; border:1px solid #d1d5db; padding:0.625rem 1rem; font-size:0.875rem; color:#374151;">
            </div>
            <div id="formMessage" style="margin-bottom:1rem; display:none; border-radius:0.5rem; padding:0.75rem; font-size:0.875rem;"></div>
            <div style="display:flex; gap:0.75rem;">
                <button type="button" id="cancelNewProductBtn"
                        style="flex:1; border-radius:0.5rem; border:1px solid #d1d5db; background:#fff; padding:0.625rem 1rem; font-size:0.875rem; font-weight:500; color:#374151; cursor:pointer;">
                    Cancelar
                </button>
                <button type="submit" id="submitNewProductBtn"
                        style="flex:1; border-radius:0.5rem; border:none; background:#465fff; padding:0.625rem 1rem; font-size:0.875rem; font-weight:500; color:#fff; cursor:pointer;">
                    Crear Producto
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal para editar producto -->
<div id="editProductModal" style="display:none; position:fixed; inset:0; z-index:99999; background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
    <div style="width:100%; max-width:28rem; border-radius:1rem; background:#fff; padding:1.5rem; box-shadow:0 10px 25px rgba(0,0,0,0.2); max-height:90vh; overflow-y:auto;">
        <div style="margin-bottom:1rem; display:flex; align-items:center; justify-content:space-between;">
            <h2 style="font-size:1.25rem; font-weight:600; color:#1f2937;">Editar Producto</h2>
            <button id="closeEditProductBtn" type="button" style="background:none; border:none; cursor:pointer; color:#9ca3af; font-size:1.5rem; line-height:1;">&times;</button>
        </div>
        <form id="editProductForm">
            <input type="hidden" id="editProductId">
            <div style="margin-bottom:1rem;">
                <label for="editProductName" style="display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.5rem;">Nombre *</label>
                <input type="text" id="editProductName" required
                       style="width:100%; border-radius:0.5rem; border:1px solid #d1d5db; padding:0.625rem 1rem; font-size:0.875rem; color:#374151;">
            </div>
            <div style="margin-bottom:1rem;">
                <label for="editProductDescription" style="display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.5rem;">Descripción</label>
                <textarea id="editProductDescription" rows="3"
                          style="width:100%; border-radius:0.5rem; border:1px solid #d1d5db; padding:0.625rem 1rem; font-size:0.875rem; color:#374151;"></textarea>
            </div>
            <div style="margin-bottom:1rem;">
                <label for="editProductCategory" style="display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.5rem;">Categoría *</label>
                <select id="editProductCategory" required
                        style="width:100%; border-radius:0.5rem; border:1px solid #d1d5db; padding:0.625rem 1rem; font-size:0.875rem; color:#374151; background:#fff;">
                    <option value="">Selecciona una categoría...</option>
                </select>
            </div>
            <div style="margin-bottom:1rem;">
                <label for="editProductUnit" style="display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.5rem;">Unidad *</label>
                <select id="editProductUnit" required
                        style="width:100%; border-radius:0.5rem; border:1px solid #d1d5db; padding:0.625rem 1rem; font-size:0.875rem; color:#374151; background:#fff;">
                    <option value="">Selecciona una unidad...</option>
                </select>
            </div>
            <div style="margin-bottom:1.5rem;">
                <label for="editProductMinimumStock" style="display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.5rem;">Stock mínimo *</label>
                <input type="number" id="editProductMinimumStock" required min="0" step="0.01"
                       style="width:100%; border-radius:0.5rem; border:1px solid #d1d5db; padding:0.625rem 1rem; font-size:0.875rem; color:#374151;">
            </div>
            <div id="editFormMessage" style="margin-bottom:1rem; display:none; border-radius:0.5rem; padding:0.75rem; font-size:0.875rem;"></div>
            <div style="display:flex; gap:0.75rem;">
                <button type="button" id="cancelEditProductBtn"
                        style="flex:1; border-radius:0.5rem; border:1px solid #d1d5db; background:#fff; padding:0.625rem 1rem; font-size:0.875rem; font-weight:500; color:#374151; cursor:pointer;">
                    Cancelar
                </button>
                <button type="submit" id="submitEditProductBtn"
                        style="flex:1; border-radius:0.5rem; border:none; background:#465fff; padding:0.625rem 1rem; font-size:0.875rem; font-weight:500; color:#fff; cursor:pointer;">
                    Actualizar
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // ===== Config global (Razor las resuelve una sola vez) =====
    const API_URL = '@Configuration["Valores:UrlApi"]';
    const TOKEN = '@Context.Session.GetString("Token")';

    let allItems = [];
    let categories = [];
    let units = [];
    let currentPage = 1;
    const itemsPerPage = 20;
    let filteredItems = [];

    // ===== Inicialización =====
    function initInventory() {
        console.log('Init Inventory. API_URL:', API_URL, 'Token:', TOKEN ? 'presente' : 'ausente');

        // Mover los modales al <body> para que 'position:fixed' no se rompa
        // por un ancestro con transform (típico en plantillas TailAdmin).
        ['newProductModal', 'editProductModal'].forEach(function (mid) {
            var m = document.getElementById(mid);
            if (m && m.parentElement !== document.body) {
                document.body.appendChild(m);
            }
        });

        // Event delegation: un solo listener para todos los clicks.
        document.addEventListener('click', function (e) {
            const t = e.target.closest('button');
            if (!t) return;

            if (t.id === 'btnNewProduct') { openNewProductModal(); return; }
            if (t.id === 'closeNewProductBtn' || t.id === 'cancelNewProductBtn') { closeNewProductModal(); return; }
            if (t.id === 'closeEditProductBtn' || t.id === 'cancelEditProductBtn') { closeEditProductModal(); return; }
            if (t.id === 'btnPrevious') { previousPage(); return; }
            if (t.id === 'btnNext') { nextPage(); return; }

            if (t.classList.contains('edit-btn')) {
                const id = parseInt(t.getAttribute('data-id'));
                const item = allItems.find(x => x.id === id);
                if (item) openEditProductModal(item);
                return;
            }
            if (t.classList.contains('delete-btn')) {
                const id = parseInt(t.getAttribute('data-id'));
                deleteProduct(id);
                return;
            }
        });

        // Submits de formularios
        document.addEventListener('submit', function (e) {
            if (e.target.id === 'newProductForm') { e.preventDefault(); handleCreateProduct(e); }
            if (e.target.id === 'editProductForm') { e.preventDefault(); handleEditProduct(e); }
        });

        // Búsqueda por texto
        const search = document.getElementById('searchInput');
        if (search) search.addEventListener('input', applyFilters);

        // Filtro por categoría
        const catFilter = document.getElementById('categoryFilter');
        if (catFilter) catFilter.addEventListener('change', applyFilters);

        // Cerrar modal al hacer clic en el fondo oscuro
        document.getElementById('newProductModal').addEventListener('click', function (e) { if (e.target === this) closeNewProductModal(); });
        document.getElementById('editProductModal').addEventListener('click', function (e) { if (e.target === this) closeEditProductModal(); });

        // Cargar catálogos (categorías y unidades) y luego el inventario
        loadCategories();
        loadUnits();
        loadInventory();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initInventory);
    } else {
        initInventory();
    }

    // ===== Helper: mostrar mensaje en un contenedor =====
    function showMsg(el, type, text) {
        var colors = {
            error: 'background:#fef2f2; color:#dc2626;',
            success: 'background:#f0fdf4; color:#16a34a;',
            info: 'background:#eff6ff; color:#2563eb;'
        };
        el.style.cssText = 'margin-bottom:1rem; border-radius:0.5rem; padding:0.75rem; font-size:0.875rem; display:block; ' + colors[type];
        el.textContent = text;
    }

    // ===== Helper: extrae el mensaje de error real de la API =====
    async function getErrorMessage(response) {
        try {
            const data = await response.json();
            return data.message || data.error || `Error ${response.status}`;
        } catch {
            return `Error ${response.status}`;
        }
    }

    // ===== Helper: nombre de categoría por id =====
    function getCategoryName(id) {
        const c = categories.find(x => x.id === id);
        return c ? c.name : '';
    }

    // ===== Cargar categorías =====
    async function loadCategories() {
        try {
            const response = await fetch(API_URL + 'inventory/GetCategories', {
                method: 'GET',
                headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' }
            });
            if (!response.ok) throw new Error(await getErrorMessage(response));
            categories = await response.json() || [];
            fillSelect('productCategory', categories);
            fillSelect('editProductCategory', categories);
            fillSelect('categoryFilter', categories); // llena también el filtro superior
        } catch (error) {
            console.error('Error cargando categorías:', error);
        }
    }

    // ===== Cargar unidades =====
    async function loadUnits() {
        try {
            const response = await fetch(API_URL + 'inventory/GetUnits', {
                method: 'GET',
                headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' }
            });
            if (!response.ok) throw new Error(await getErrorMessage(response));
            units = await response.json() || [];
            fillSelect('productUnit', units);
            fillSelect('editProductUnit', units);
        } catch (error) {
            console.error('Error cargando unidades:', error);
        }
    }

    // ===== Rellena un <select> con opciones =====
    function fillSelect(selectId, data) {
        const sel = document.getElementById(selectId);
        if (!sel) return;
        const first = sel.querySelector('option'); // conserva el placeholder
        sel.innerHTML = '';
        if (first) sel.appendChild(first);
        data.forEach(function (d) {
            const opt = document.createElement('option');
            opt.value = d.id;
            opt.textContent = d.abbreviation ? `${d.name} (${d.abbreviation})` : d.name;
            sel.appendChild(opt);
        });
    }

    // ===== Cargar inventario desde API =====
    async function loadInventory() {
        try {
            const apiUrl = API_URL + 'inventory/GetInventoryItems';
            if (!TOKEN) throw new Error('No hay sesión activa. Por favor, inicia sesión.');

            const response = await fetch(apiUrl, {
                method: 'GET',
                headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' }
            });

            if (!response.ok) throw new Error(await getErrorMessage(response));

            const items = await response.json();
            allItems = items || [];
            applyFilters();
        } catch (error) {
            console.error('Error loadInventory:', error);
            document.getElementById('inventoryTableBody').innerHTML = `
                <tr>
                    <td colspan="6" class="px-4 py-8">
                        <div class="text-center text-red-600">Error: ${error.message}</div>
                    </td>
                </tr>
            `;
        }
    }

    // ===== Aplica filtros de búsqueda Y categoría al mismo tiempo =====
    function applyFilters() {
        const searchTerm = (document.getElementById('searchInput')?.value || '').toLowerCase();
        const catValue = document.getElementById('categoryFilter')?.value || '';
        const catId = catValue ? parseInt(catValue) : null;

        filteredItems = allItems.filter(item => {
            // Coincide con la búsqueda de texto
            const matchText = !searchTerm ||
                (item.name && item.name.toLowerCase().includes(searchTerm)) ||
                (item.description && item.description.toLowerCase().includes(searchTerm));

            // Coincide con la categoría seleccionada
            const matchCat = !catId || item.inventory_category_id === catId;

            return matchText && matchCat;
        });

        currentPage = 1;
        displayInventory();
    }

    // ===== Mostrar tabla =====
    function displayInventory() {
        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const paginatedItems = filteredItems.slice(startIndex, endIndex);
        const container = document.getElementById('inventoryTableBody');

        if (!paginatedItems || paginatedItems.length === 0) {
            container.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">No hay productos</td></tr>`;
            document.getElementById('itemCount').textContent = '0';
            document.getElementById('totalCount').textContent = filteredItems.length;
            return;
        }

        container.innerHTML = paginatedItems.map(item => `
            <tr>
                <td class="px-4 py-4 text-sm font-medium">${item.name}</td>
                <td class="px-4 py-4 text-sm">${item.description || ''}</td>
                <td class="px-4 py-4 text-sm">${getCategoryName(item.inventory_category_id)}</td>
                <td class="px-4 py-4 text-sm">${item.minimum_stock}</td>
                <td class="px-4 py-4"><span class="bg-green-50 px-2 py-1 text-xs text-green-600 rounded">Disponible</span></td>
                <td class="px-4 py-4">
                    <button class="text-xs text-blue-600 hover:text-blue-700 mr-3 edit-btn" data-id="${item.id}" type="button">Editar</button>
                    <button class="text-xs text-red-600 hover:text-red-700 delete-btn" data-id="${item.id}" type="button">Eliminar</button>
                </td>
            </tr>
        `).join('');

        document.getElementById('itemCount').textContent = Math.min(endIndex, filteredItems.length);
        document.getElementById('totalCount').textContent = filteredItems.length;
    }

    // ===== Paginación =====
    function nextPage() {
        const maxPages = Math.ceil(filteredItems.length / itemsPerPage);
        if (currentPage < maxPages) { currentPage++; displayInventory(); }
    }

    function previousPage() {
        if (currentPage > 1) { currentPage--; displayInventory(); }
    }

    // ===== Modal crear =====
    function openNewProductModal() {
        const modal = document.getElementById('newProductModal');
        modal.style.display = 'flex';
        document.getElementById('newProductForm').reset();
        document.getElementById('formMessage').style.display = 'none';
        document.getElementById('submitNewProductBtn').disabled = false;
    }

    function closeNewProductModal() {
        document.getElementById('newProductModal').style.display = 'none';
        document.getElementById('newProductForm').reset();
        document.getElementById('formMessage').style.display = 'none';
    }

    // ===== Crear producto =====
    async function handleCreateProduct(e) {
        e.preventDefault();
        const msg = document.getElementById('formMessage');
        const btn = document.getElementById('submitNewProductBtn');

        try {
            const name = document.getElementById('productName').value.trim();
            const description = document.getElementById('productDescription').value.trim();
            const categoryId = parseInt(document.getElementById('productCategory').value);
            const unitId = parseInt(document.getElementById('productUnit').value);
            const stock = parseFloat(document.getElementById('productMinimumStock').value);

            if (!name) throw new Error('El nombre es obligatorio');
            if (isNaN(categoryId)) throw new Error('Selecciona una categoría');
            if (isNaN(unitId)) throw new Error('Selecciona una unidad');
            if (isNaN(stock) || stock < 0) throw new Error('El stock mínimo no es válido');
            if (!TOKEN) throw new Error('No hay sesión activa. Por favor, inicia sesión.');

            btn.disabled = true;
            showMsg(msg, 'info', 'Creando producto...');

            const response = await fetch(API_URL + 'inventory/CreateInventoryItem', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name: name,
                    description: description,
                    minimum_stock: stock,
                    inventory_category_id: categoryId,
                    inventory_unit_id: unitId
                })
            });

            if (!response.ok) throw new Error(await getErrorMessage(response));

            showMsg(msg, 'success', '¡Producto creado exitosamente!');
            setTimeout(() => { closeNewProductModal(); loadInventory(); }, 1500);
        } catch (error) {
            console.error('Error crear:', error);
            showMsg(msg, 'error', 'Error: ' + error.message);
            btn.disabled = false;
        }
    }

    // ===== Modal editar =====
    function openEditProductModal(item) {
        document.getElementById('editProductId').value = item.id;
        document.getElementById('editProductName').value = item.name;
        document.getElementById('editProductDescription').value = item.description || '';
        document.getElementById('editProductMinimumStock').value = item.minimum_stock;
        document.getElementById('editProductCategory').value = item.inventory_category_id || '';
        document.getElementById('editProductUnit').value = item.inventory_unit_id || '';
        document.getElementById('editProductModal').style.display = 'flex';
        document.getElementById('editFormMessage').style.display = 'none';
        document.getElementById('submitEditProductBtn').disabled = false;
    }

    function closeEditProductModal() {
        document.getElementById('editProductModal').style.display = 'none';
        document.getElementById('editProductForm').reset();
        document.getElementById('editFormMessage').style.display = 'none';
    }

    // ===== Actualizar producto =====
    async function handleEditProduct(e) {
        e.preventDefault();
        const msg = document.getElementById('editFormMessage');
        const btn = document.getElementById('submitEditProductBtn');

        try {
            const id = document.getElementById('editProductId').value;
            const name = document.getElementById('editProductName').value.trim();
            const description = document.getElementById('editProductDescription').value.trim();
            const categoryId = parseInt(document.getElementById('editProductCategory').value);
            const unitId = parseInt(document.getElementById('editProductUnit').value);
            const stock = parseFloat(document.getElementById('editProductMinimumStock').value);

            if (!name) throw new Error('El nombre es obligatorio');
            if (isNaN(categoryId)) throw new Error('Selecciona una categoría');
            if (isNaN(unitId)) throw new Error('Selecciona una unidad');
            if (isNaN(stock) || stock < 0) throw new Error('El stock mínimo no es válido');
            if (!TOKEN) throw new Error('No hay sesión activa. Por favor, inicia sesión.');

            btn.disabled = true;
            showMsg(msg, 'info', 'Actualizando producto...');

            const response = await fetch(`${API_URL}inventory/UpdateInventoryItem/${id}`, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name: name,
                    description: description,
                    minimum_stock: stock,
                    inventory_category_id: categoryId,
                    inventory_unit_id: unitId
                })
            });

            if (!response.ok) throw new Error(await getErrorMessage(response));

            showMsg(msg, 'success', '¡Actualizado correctamente!');
            setTimeout(() => { closeEditProductModal(); loadInventory(); }, 1500);
        } catch (error) {
            console.error('Error actualizar:', error);
            showMsg(msg, 'error', 'Error: ' + error.message);
            btn.disabled = false;
        }
    }

    // ===== Eliminar producto =====
    async function deleteProduct(id) {
        if (!confirm('¿Eliminar este producto?')) return;

        try {
            if (!TOKEN) { alert('No hay sesión activa. Por favor, inicia sesión.'); return; }

            const response = await fetch(`${API_URL}inventory/DeleteInventoryItem/${id}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' }
            });

            if (!response.ok) throw new Error(await getErrorMessage(response));

            alert('Producto eliminado exitosamente');
            loadInventory();
        } catch (error) {
            console.error('Error eliminar:', error);
            alert('Error: ' + error.message);
        }
    }
</script>
