@model int
@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Editar colaborador"; }
<div class="mx-auto max-w-3xl" x-data="staffEdit()" x-init="load()"><div class="mb-6"><h1 class="text-2xl font-semibold dark:text-white">Editar colaborador</h1><p class="mt-1 text-sm text-gray-500">Actualiza la información de la persona colaboradora.</p></div><p x-show="message" x-text="message" class="mb-4 rounded bg-red-50 p-3 text-sm text-red-700"></p><form x-show="loaded" @@submit.prevent="save()" class="grid gap-4 rounded-2xl border bg-white p-6 sm:grid-cols-2 dark:bg-white/[.03]"><label class="text-sm">Nombre<input required x-model="form.first_name" class="mt-1 w-full rounded border p-2"></label><label class="text-sm">Apellido<input required x-model="form.last_name" class="mt-1 w-full rounded border p-2"></label><label class="text-sm">Rol<select required x-model.number="form.staff_role_id" class="mt-1 w-full rounded border p-2"><option value="">Seleccione</option><template x-for="role in refs.roles"><option :value="role.id" x-text="role.name"></option></template></select></label><label class="text-sm">Identificación<input x-model="form.identification_number" class="mt-1 w-full rounded border p-2"></label><label class="text-sm">Correo<input type="email" x-model="form.email" class="mt-1 w-full rounded border p-2"></label><label class="text-sm">Teléfono<input x-model="form.phone" class="mt-1 w-full rounded border p-2"></label><fieldset class="sm:col-span-2"><legend class="mb-2 text-sm font-medium">Especialidades</legend><div class="flex flex-wrap gap-3"><template x-for="s in refs.specialties"><label class="text-sm"><input type="checkbox" :value="s.id" x-model="form.specialty_ids"> <span x-text="s.name"></span></label></template></div></fieldset><div class="sm:col-span-2 flex justify-end gap-3"><a asp-action="Index" class="rounded border px-4 py-2 text-sm">Cancelar</a><button class="rounded bg-brand-500 px-4 py-2 text-white">Guardar cambios</button></div></form></div>
@section Scripts { <script>function staffEdit(){const id=@Model,base='@Configuration["Valores:UrlApi"]Staff',h={'Content-Type':'application/json','Authorization':'Bearer @Context.Session.GetString("Token")'};return{message:'',loaded:false,refs:{roles:[],specialties:[]},form:{specialty_ids:[]},async load(){let [refs,member]=await Promise.all([fetch(base+'/References',{headers:h}),fetch(base+'/'+id,{headers:h})]);if(refs.ok)this.refs=await refs.json();if(!member.ok){this.message='No fue posible cargar el colaborador.';return}this.form={...(await member.json()),specialty_ids:[]};this.loaded=true},async save(){let r=await fetch(base+'/'+id,{method:'PUT',headers:h,body:JSON.stringify(this.form)});if(!r.ok){this.message=await r.text();return}window.location.href='@Url.Action("Index", "Staff")'}}}</script> }
