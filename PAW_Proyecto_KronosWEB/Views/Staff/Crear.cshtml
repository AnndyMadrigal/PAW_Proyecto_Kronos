@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Nuevo colaborador"; }
<div class="mx-auto max-w-3xl" x-data="staffForm()" x-init="references()"><div class="mb-6"><h1 class="text-2xl font-semibold dark:text-white">Nuevo colaborador</h1><p class="mt-1 text-sm text-gray-500">Registra una persona colaboradora y su rol operativo.</p></div><p x-show="message" x-text="message" class="mb-4 rounded bg-red-50 p-3 text-sm text-red-700"></p><form @@submit.prevent="save()" class="grid gap-4 rounded-2xl border bg-white p-6 sm:grid-cols-2 dark:bg-white/[.03]"><label class="text-sm">Nombre<input required x-model="form.first_name" class="mt-1 w-full rounded border p-2"></label><label class="text-sm">Apellido<input required x-model="form.last_name" class="mt-1 w-full rounded border p-2"></label><label class="text-sm">Rol<select required x-model.number="form.staff_role_id" class="mt-1 w-full rounded border p-2"><option value="">Seleccione</option><template x-for="role in refs.roles"><option :value="role.id" x-text="role.name"></option></template></select></label><label class="text-sm">Identificación<input x-model="form.identification_number" class="mt-1 w-full rounded border p-2"></label><label class="text-sm">Correo<input type="email" x-model="form.email" class="mt-1 w-full rounded border p-2"></label><label class="text-sm">Teléfono<input x-model="form.phone" class="mt-1 w-full rounded border p-2"></label><fieldset class="sm:col-span-2"><legend class="mb-2 text-sm font-medium">Especialidades</legend><div class="flex flex-wrap gap-3"><template x-for="s in refs.specialties"><label class="text-sm"><input type="checkbox" :value="s.id" x-model="form.specialty_ids"> <span x-text="s.name"></span></label></template></div></fieldset><div class="sm:col-span-2 flex justify-end gap-3"><a asp-action="Index" class="rounded border px-4 py-2 text-sm">Cancelar</a><button class="rounded bg-brand-500 px-4 py-2 text-white">Guardar colaborador</button></div></form></div>
@section Scripts { <script>function staffForm(){const base='@Configuration["Valores:UrlApi"]Staff',h={'Content-Type':'application/json','Authorization':'Bearer @Context.Session.GetString("Token")'};return{message:'',refs:{roles:[],specialties:[]},form:{staff_role_id:'',first_name:'',last_name:'',identification_number:'',phone:'',email:'',specialty_ids:[]},async references(){let r=await fetch(base+'/References',{headers:h});if(r.ok)this.refs=await r.json()},async save(){let r=await fetch(base,{method:'POST',headers:h,body:JSON.stringify(this.form)});if(!r.ok){this.message=await r.text();return}window.location.href='@Url.Action("Index", "Staff")'}}}</script> }
