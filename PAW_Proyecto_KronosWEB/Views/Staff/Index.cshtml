@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Personal y disponibilidad"; }
<div class="space-y-6" x-data="staffList()" x-init="members()">
 <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center"><div><h1 class="text-2xl font-semibold text-gray-800 dark:text-white">Personal</h1><p class="mt-1 text-sm text-gray-500">Colaboradores, roles y franjas reales de disponibilidad.</p></div><a asp-action="Crear" class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white">Nuevo colaborador</a></div>
 <p x-show="message" class="rounded-lg bg-red-50 p-3 text-sm text-red-700" x-text="message"></p>
 <section class="rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[.03]"><div class="mb-4 flex gap-2"><input x-model="search" @@input.debounce.300ms="members()" placeholder="Buscar colaborador" class="w-full max-w-md rounded border p-2"></div><div class="overflow-x-auto"><table class="min-w-full text-sm"><thead><tr class="border-b text-left"><th class="p-2">Colaborador</th><th class="p-2">Rol</th><th class="p-2">Contacto</th><th class="p-2">Agenda</th><th class="p-2"></th></tr></thead><tbody><template x-for="m in items" :key="m.id"><tr class="border-b"><td class="p-2 font-medium" x-text="m.first_name+' '+m.last_name"></td><td class="p-2" x-text="m.staff_role_name"></td><td class="p-2"><span x-text="m.email||'—'"></span><span class="block text-xs text-gray-500" x-text="m.phone||''"></span></td><td class="p-2"><button @@click="openAvailability(m)" class="text-brand-600">Disponibilidad</button></td><td class="p-2"><a :href="'@Url.Action("Editar", "Staff")/' + m.id" class="text-gray-600">Editar</a> <button @@click="remove(m.id)" class="text-red-600">Eliminar</button></td></tr></template></tbody></table></div></section>
 <section x-show="availabilityOpen" x-cloak class="rounded-xl border border-brand-200 bg-white p-5 dark:bg-white/[.03]"><div class="mb-3 flex justify-between"><h2 class="font-semibold" x-text="'Disponibilidad de '+selectedName"></h2><button @@click="availabilityOpen=false">×</button></div><form @@submit.prevent="saveAvailability()" class="grid gap-3 md:grid-cols-4"><input required type="date" x-model="availability.available_date" class="rounded border p-2"><input required type="time" x-model="availability.start_time" class="rounded border p-2"><input required type="time" x-model="availability.end_time" class="rounded border p-2"><select x-model="availability.is_available" class="rounded border p-2"><option value="true">Disponible</option><option value="false">No disponible</option></select><button class="rounded bg-brand-500 px-4 py-2 text-white">Agregar franja</button></form><div class="mt-4 space-y-2"><template x-for="a in availabilityItems" :key="a.id"><div class="rounded bg-gray-50 p-2 text-sm dark:bg-gray-800"><span x-text="new Date(a.available_date).toLocaleDateString('es-CR')"></span> · <span x-text="a.start_time+' – '+a.end_time"></span> · <span x-text="a.is_available?'Disponible':'No disponible'"></span></div></template></div></section>
</div>
@section Scripts { <script>function staffList(){const base='@Configuration["Valores:UrlApi"]Staff',h={'Content-Type':'application/json','Authorization':'Bearer @Context.Session.GetString("Token")'};return{items:[],search:'',message:'',availabilityOpen:false,selectedId:null,selectedName:'',availabilityItems:[],availability:{available_date:new Date().toISOString().slice(0,10),start_time:'08:00',end_time:'17:00',is_available:'true'},async members(){let r=await fetch(base+'?search='+encodeURIComponent(this.search),{headers:h});if(r.ok)this.items=await r.json()},async remove(id){if(!confirm('¿Eliminar este colaborador?'))return;let r=await fetch(base+'/'+id,{method:'DELETE',headers:h});if(!r.ok)this.message=await r.text();await this.members()},async openAvailability(m){this.selectedId=m.id;this.selectedName=m.first_name+' '+m.last_name;this.availabilityOpen=true;await this.availabilityLoad()},async availabilityLoad(){let r=await fetch(base+'/'+this.selectedId+'/Availability',{headers:h});if(r.ok)this.availabilityItems=await r.json()},async saveAvailability(){let r=await fetch(base+'/Availability',{method:'POST',headers:h,body:JSON.stringify({...this.availability,staff_member_id:this.selectedId,is_available:this.availability.is_available==='true'})});if(!r.ok){this.message=await r.text();return}await this.availabilityLoad()}}}</script> }
