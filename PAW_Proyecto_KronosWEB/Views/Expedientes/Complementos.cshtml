@model int
@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Registro clínico ampliado"; var patientId = (int)ViewBag.PatientId; }
<div class="space-y-6" x-data="clinicalExtras()" x-init="load()">
 <div class="flex justify-between"><div><h1 class="text-2xl font-semibold dark:text-white">Registro clínico ampliado</h1><p class="text-sm text-gray-500">Signos vitales, alergias, plan de cuidados e historial de accesos.</p></div><a asp-action="Detalle" asp-route-medicalRecordId="@Model" class="rounded border px-4 py-2 text-sm">Volver al expediente</a></div>
 <p x-show="message" x-text="message" class="rounded bg-red-50 p-3 text-sm text-red-700"></p>
 <div class="grid gap-6 lg:grid-cols-2"><section class="rounded-xl border bg-white p-5 dark:bg-white/[.03]"><h2 class="mb-3 font-semibold">Signos vitales</h2><form @@submit.prevent="save('vital')" class="grid gap-2 sm:grid-cols-2"><input x-model="vital.blood_pressure" placeholder="Presión arterial"><input type="number" x-model.number="vital.heart_rate" placeholder="Frecuencia cardíaca"><input type="number" step=".01" x-model.number="vital.temperature" placeholder="Temperatura °C"><input type="number" step=".01" x-model.number="vital.oxygen_saturation" placeholder="Saturación O₂"><input type="number" x-model.number="vital.respiratory_rate" placeholder="Frecuencia respiratoria"><textarea x-model="vital.notes" placeholder="Observaciones"></textarea><button class="rounded bg-brand-500 px-4 py-2 text-white sm:col-span-2">Registrar signos vitales</button></form><template x-for="x in data.vital_signs"><p class="mt-3 border-t pt-2 text-sm"><b x-text="new Date(x.recorded_at).toLocaleString('es-CR')"></b> · <span x-text="x.blood_pressure||'Sin presión registrada'"></span> · FC <span x-text="x.heart_rate||'—'"></span></p></template></section>
 <section class="rounded-xl border bg-white p-5 dark:bg-white/[.03]"><h2 class="mb-3 font-semibold">Alergias</h2><form @@submit.prevent="save('allergy')" class="grid gap-2"><select required x-model.number="allergy.medical_allergy_id"><option value="">Seleccione una alergia</option><template x-for="x in refs.allergies"><option :value="x.id" x-text="x.name"></option></template></select><select x-model.number="allergy.severity_id"><option value="">Severidad no especificada</option><template x-for="x in refs.allergy_severities"><option :value="x.id" x-text="x.name"></option></template></select><input x-model="allergy.reaction" placeholder="Reacción observada"><textarea x-model="allergy.notes" placeholder="Notas"></textarea><button class="rounded bg-brand-500 px-4 py-2 text-white">Registrar alergia</button></form><template x-for="x in data.allergies"><p class="mt-3 border-t pt-2 text-sm"><b x-text="x.allergy_name"></b>: <span x-text="x.reaction||'Sin reacción especificada'"></span></p></template></section>
 <section class="rounded-xl border bg-white p-5 dark:bg-white/[.03]"><h2 class="mb-3 font-semibold">Plan de cuidados</h2><form @@submit.prevent="save('plan')" class="grid gap-2"><input required x-model="plan.title" placeholder="Objetivo o título"><textarea x-model="plan.description" placeholder="Descripción del plan"></textarea><input type="date" x-model="plan.start_date"><input type="date" x-model="plan.end_date"><select required x-model.number="plan.status_id"><option value="">Seleccione el estado</option><template x-for="x in refs.care_plan_statuses"><option :value="x.id" x-text="x.name"></option></template></select><button class="rounded bg-brand-500 px-4 py-2 text-white">Crear plan</button></form><template x-for="x in data.care_plans"><p class="mt-3 border-t pt-2 text-sm"><b x-text="x.title"></b><span class="block" x-text="x.status_name"></span></p></template></section>
 <section class="rounded-xl border bg-white p-5 dark:bg-white/[.03]"><h2 class="mb-3 font-semibold">Actividades del plan</h2><form @@submit.prevent="save('activity')" class="grid gap-2"><select required x-model.number="activity.patient_care_plan_id"><option value="">Seleccione un plan</option><template x-for="x in data.care_plans"><option :value="x.id" x-text="x.title"></option></template></select><input required x-model="activity.title" placeholder="Actividad"><input type="date" x-model="activity.due_date"><select required x-model.number="activity.status_id"><option value="">Seleccione el estado</option><template x-for="x in refs.care_plan_statuses"><option :value="x.id" x-text="x.name"></option></template></select><button class="rounded bg-brand-500 px-4 py-2 text-white">Agregar actividad</button></form><template x-for="x in data.activities"><p class="mt-3 border-t pt-2 text-sm"><b x-text="x.title"></b> · <span x-text="x.status_name"></span></p></template></section>
 <section class="rounded-xl border bg-white p-5 dark:bg-white/[.03]"><h2 class="mb-3 font-semibold">Historial de accesos</h2><template x-for="x in data.access_logs"><p class="border-b py-2 text-sm"><b x-text="x.user_name||'Usuario' "></b><span class="block text-gray-500" x-text="new Date(x.created_at).toLocaleString('es-CR')+' · '+(x.access_reason||'Consulta de expediente')"></span></p></template><p x-show="!data.access_logs.length" class="text-sm text-gray-500">Aún no hay accesos registrados.</p></section></div>
</div>
@section Scripts { <script>function clinicalExtras(){const base='@Configuration["Valores:UrlApi"]Expedientes/',h={'Content-Type':'application/json','Authorization':'Bearer @Context.Session.GetString("Token")'},record=@Model,patient=@patientId;return{data:{vital_signs:[],allergies:[],care_plans:[],activities:[],access_logs:[]},refs:{allergies:[],allergy_severities:[],care_plan_statuses:[]},message:'',vital:{},allergy:{},plan:{},activity:{},async load(){let [a,b]=await Promise.all([fetch(base+'ComplementosClinicosAPI?medicalRecordId='+record,{headers:h}),fetch(base+'ComplementosReferenciasAPI',{headers:h})]);if(a.ok)this.data=await a.json();else this.message='No se pudo cargar el registro clínico.';if(b.ok)this.refs=await b.json()},async save(type){let url,payload;if(type==='vital'){url='GuardarSignosVitalesAPI';payload={...this.vital,patient_id:patient}}else if(type==='allergy'){url='GuardarAlergiaAPI';payload={...this.allergy,patient_id:patient}}else if(type==='activity'){url='GuardarActividadPlanAPI';payload=this.activity}else{url='GuardarPlanCuidadosAPI';payload={...this.plan,patient_id:patient}}let r=await fetch(base+url,{method:'POST',headers:h,body:JSON.stringify(payload)});if(!r.ok){this.message=await r.text();return}await this.load()}}}</script> }
