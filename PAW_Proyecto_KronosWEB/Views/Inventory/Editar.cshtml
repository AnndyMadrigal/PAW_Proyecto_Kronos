@model InventoryModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar producto";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="rounded-xl bg-white p-6 shadow-sm dark:bg-gray-800">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Editar producto</h1>
        <p class="mt-1 text-sm text-gray-500">Modifica los datos del producto o insumo médico.</p>

        @if (ViewBag.Mensaje is string message)
        {
            <div class="mt-5 rounded-lg bg-red-50 p-4 text-sm text-red-700">@message</div>
        }

        <form asp-controller="Inventory" asp-action="Editar" method="post" id="editInventoryForm" class="mt-6 space-y-5">
            <input asp-for="id" type="hidden" />

            <div>
                <label asp-for="name" class="block text-sm font-medium">Nombre del producto *</label>
                <input asp-for="name" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900 dark:border-gray-700" />
            </div>

            <div>
                <label asp-for="description" class="block text-sm font-medium">Descripción</label>
                <textarea asp-for="description" rows="2" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900 dark:border-gray-700"></textarea>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="inventory_category_id" class="block text-sm font-medium">Categoría *</label>
                    <select asp-for="inventory_category_id" asp-items="@(new SelectList(Model.Categories, "id", "name"))" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900 dark:border-gray-700">
                        <option value="">Selecciona una categoría</option>
                    </select>
                </div>

                <div>
                    <label asp-for="inventory_unit_id" class="block text-sm font-medium">Unidad de medida *</label>
                    <select asp-for="inventory_unit_id" asp-items="@(new SelectList(Model.Units, "id", "DisplayName"))" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900 dark:border-gray-700">
                        <option value="">Selecciona una unidad</option>
                    </select>
                </div>
            </div>

            <div>
                <label asp-for="minimum_stock" class="block text-sm font-medium">Stock mínimo de alerta *</label>
                <input asp-for="minimum_stock" type="number" min="0" step="0.01" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900 dark:border-gray-700" />
            </div>

            <div class="pt-2 flex items-center justify-between">
                <div>
                    <button type="submit" class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white hover:bg-brand-600 cursor-pointer">Guardar cambios</button>
                    <a asp-action="Index" class="ml-3 text-sm text-gray-600 hover:underline">Cancelar</a>
                </div>
            </div>
        </form>
    </div>

    <!-- Zona de peligro: Eliminar producto -->
    <div class="rounded-xl border border-red-200 bg-red-50/40 p-6 dark:border-red-900/50 dark:bg-red-950/20">
        <h2 class="text-base font-semibold text-red-900 dark:text-red-300">Dar de baja producto</h2>
        <p class="mt-1 text-xs text-red-700 dark:text-red-400">Esta acción marcará el producto como inactivo y lo ocultará de las listas de inventario activo.</p>
        <form asp-controller="Inventory" asp-action="Eliminar" method="post" class="mt-4" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este producto?');">
            <input type="hidden" name="id" value="@Model.id" />
            <button type="submit" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 cursor-pointer">
                Eliminar producto
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/inventory.js" asp-append-version="true"></script>
}
