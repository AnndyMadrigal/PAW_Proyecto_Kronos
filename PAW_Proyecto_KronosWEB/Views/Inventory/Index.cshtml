@model List<InventoryStockViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Inventario";
    var isAdministrator = string.Equals(Context.Session.GetString("RoleName"), "Administrador", StringComparison.OrdinalIgnoreCase);
    var lowStock = Model.Count(x => x.quantity_available <= x.minimum_stock);
}
<div class="space-y-6">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div><h1 class="text-2xl font-semibold text-gray-800 dark:text-white">Stock actual</h1><p class="mt-1 text-sm text-gray-500">Existencias disponibles, niveles mínimos y acciones operativas de inventario.</p></div>
        <div class="flex flex-wrap gap-3">
            <a asp-action="Movimientos" class="rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white">Registrar movimiento</a>
            @if (isAdministrator) { <a asp-action="Crear" class="rounded-lg border border-brand-500 px-4 py-2.5 text-sm font-medium text-brand-600">Registrar producto</a> }
        </div>
    </div>
    @if (TempData["Mensaje"] is string message) { <div class="rounded-lg bg-green-50 p-3 text-green-700">@message</div> }
    @if (TempData["MensajeError"] is string error) { <div class="rounded-lg bg-red-50 p-3 text-red-700">@error</div> }
    <div class="grid gap-4 sm:grid-cols-3"><div class="rounded-2xl border bg-white p-5"><p class="text-sm text-gray-500">Productos con stock</p><p class="mt-2 text-3xl font-semibold">@Model.Count</p></div><div class="rounded-2xl border bg-white p-5"><p class="text-sm text-gray-500">Unidades disponibles</p><p class="mt-2 text-3xl font-semibold">@(Model.Sum(x => x.quantity_available).ToString("0.##"))</p></div><div class="rounded-2xl border bg-white p-5"><p class="text-sm text-gray-500">Pendientes de reposición</p><p class="mt-2 text-3xl font-semibold @(lowStock > 0 ? "text-amber-600" : "text-green-600")">@lowStock</p></div></div>
    <form method="get" class="flex gap-3"><input name="search" value="@ViewBag.Search" placeholder="Buscar por producto o categoría" class="w-full max-w-md rounded-lg border px-3 py-2"><button class="rounded-lg border px-4 py-2">Buscar</button></form>
    <section class="overflow-x-auto rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[.03]"><table class="min-w-full text-sm"><thead class="border-b bg-gray-50 text-left text-gray-500 dark:bg-white/[.02]"><tr><th class="p-4">Producto</th><th class="p-4">Categoría</th><th class="p-4">Disponible</th><th class="p-4">Mínimo</th><th class="p-4">Estado</th></tr></thead><tbody>@foreach (var item in Model) { var needsRestock = item.quantity_available <= item.minimum_stock; <tr class="border-b"><td class="p-4 font-medium">@item.name</td><td class="p-4">@item.category_name</td><td class="p-4">@(item.quantity_available.ToString("0.##")) @item.unit_name</td><td class="p-4">@(item.minimum_stock.ToString("0.##"))</td><td class="p-4"><span class="rounded-full px-2.5 py-1 text-xs @(needsRestock ? "bg-amber-50 text-amber-700" : "bg-green-50 text-green-700")">@(needsRestock ? "Reponer" : "Disponible")</span></td></tr> } @if (!Model.Any()) { <tr><td colspan="5" class="p-8 text-center text-gray-500">No hay existencias registradas para mostrar.</td></tr> }</tbody></table></section>
</div>
