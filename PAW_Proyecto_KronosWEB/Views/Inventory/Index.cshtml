@model List<InventoryModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Inventario";
}

<div class="p-6">
    <!-- Header -->
    <div class="mb-6 flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-gray-800 dark:text-white/90">
                Inventario de insumos
            </h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                Listado completo de todos los productos disponibles en el inventario.
            </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
            <input type="text" id="searchInput" placeholder="Buscar producto..."
                   class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-700 placeholder-gray-400 shadow-theme-xs focus:border-brand-500 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:placeholder-gray-500">

            <!-- Filtro por categoría -->
            <select id="categoryFilter"
                    class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-700 shadow-theme-xs focus:border-brand-500 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                <option value="">Todas las categorías</option>
                @if (Model != null)
                {
                    @foreach (var cat in Model.Where(m => !string.IsNullOrEmpty(m.category_name)).GroupBy(m => new { m.inventory_category_id, m.category_name }).Select(g => g.Key))
                    {
                        <option value="@cat.inventory_category_id">@cat.category_name</option>
                    }
                }
            </select>

            <a asp-action="Crear" class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600">
                Nuevo producto
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="mb-6 flex items-center gap-3 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 dark:bg-green-500/10 dark:border-green-500/20 dark:text-green-400">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-sm font-medium">@TempData["Mensaje"]</span>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="mb-6 flex items-center gap-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 dark:bg-red-500/10 dark:border-red-500/20 dark:text-red-400">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm font-medium">@TempData["MensajeError"]</span>
        </div>
    }

    <!-- Inventory Table -->
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead>
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Producto</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Descripción</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Categoría</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Stock mínimo</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Estado</th>
                        <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Acciones</th>
                    </tr>
                </thead>
                <tbody id="inventoryTableBody" class="divide-y divide-gray-100 dark:divide-gray-800">
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-sm text-gray-500 dark:text-gray-400">
                                No hay productos en el inventario.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="inventory-row border-b border-gray-100 dark:border-gray-800" data-search="@(item.name.ToLower()) @(item.description.ToLower())" data-category="@item.inventory_category_id">
                                <td class="px-4 py-4 text-sm font-medium text-gray-800 dark:text-white/90">@item.name</td>
                                <td class="px-4 py-4 text-sm text-gray-600 dark:text-gray-400">@(string.IsNullOrWhiteSpace(item.description) ? "" : item.description)</td>
                                <td class="px-4 py-4 text-sm text-gray-600 dark:text-gray-400">@(string.IsNullOrWhiteSpace(item.category_name) ? "Sin categoría" : item.category_name)</td>
                                <td class="px-4 py-4 text-sm text-gray-600 dark:text-gray-400">@item.minimum_stock.ToString("0.##")</td>
                                <td class="px-4 py-4">
                                    <span class="bg-green-50 px-2 py-1 text-xs text-green-600 rounded">@(item.is_active ? "Disponible" : "Inactivo")</span>
                                </td>
                                <td class="px-4 py-4">
                                    <a asp-action="Editar" asp-route-id="@item.id" class="text-xs text-blue-600 hover:text-blue-700 mr-3">Editar</a>
                                    <form asp-action="Eliminar" method="post" class="inline delete-inventory-form">
                                        <input type="hidden" name="id" value="@item.id" />
                                        <button type="submit" class="text-xs text-red-600 hover:text-red-700 bg-transparent border-0 p-0 cursor-pointer">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <div class="mt-6 flex items-center justify-between rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-sm text-gray-600 dark:text-gray-400">
            Mostrando <span id="itemCount">@(Model?.Count ?? 0)</span> de <span id="totalCount">@(Model?.Count ?? 0)</span> productos
        </p>
        <div class="flex gap-2">
            <button id="btnPrevious" type="button"
                    class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-white/[0.03]">
                Anterior
            </button>
            <button id="btnNext" type="button"
                    class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-white/[0.03]">
                Siguiente
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/inventory.js" asp-append-version="true"></script>
}
