@model CitaAgendaViewModel
@{ Layout="_Layout"; ViewData["Title"]="Agenda"; var days=Enumerable.Range(0,(Model.EndDate-Model.StartDate).Days+1).Select(i=>Model.StartDate.AddDays(i)); }
<div class="space-y-5"><div class="flex justify-between"><div><h1 class="text-2xl font-semibold dark:text-white">Agenda @(Model.Mode=="week"?"semanal":"diaria")</h1><p class="text-sm text-gray-500">@Model.StartDate.ToString("dd/MM/yyyy") – @Model.EndDate.ToString("dd/MM/yyyy")</p></div><a asp-action="Index" class="rounded border px-4 py-2 text-sm">Calendario mensual</a></div><form method="get" class="flex flex-wrap gap-2 rounded-xl border bg-white p-4 dark:bg-white/[.03]"><input type="date" name="date" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="rounded border p-2"><select name="mode" class="rounded border p-2"><option value="day" selected="@(Model.Mode=="day")">Día</option><option value="week" selected="@(Model.Mode=="week")">Semana</option></select><select name="staffMemberId" class="rounded border p-2"><option value="">Todo el personal</option>@foreach(var s in Model.Colaboradores){<option value="@s.id" selected="@(Model.StaffMemberId==s.id)">@s.first_name @s.last_name</option>}</select><button class="rounded bg-brand-500 px-4 text-white">Ver agenda</button></form><div class="grid gap-4 @(Model.Mode=="week"?"lg:grid-cols-7":"")">@foreach(var day in days){var citas=Model.Citas.Where(x=>x.scheduled_start_at.Date==day.Date).OrderBy(x=>x.scheduled_start_at);<section class="min-h-48 rounded-xl border bg-white p-4 dark:border-gray-800 dark:bg-white/[.03]"><h2 class="mb-3 font-semibold dark:text-white">@day.ToString("ddd dd/MM")</h2><div class="space-y-2">@foreach(var c in citas){<a asp-action="Detalle" asp-route-id="@c.id" class="block rounded-lg border-l-4 border-brand-500 bg-gray-50 p-2 text-sm dark:bg-gray-800"><b>@c.scheduled_start_at.ToString("HH:mm")</b> @c.patient_first_name @c.patient_last_name<span class="block text-xs text-gray-500">@c.staff_first_name @c.staff_last_name · @c.status_name</span></a>}@if(!citas.Any()){<p class="text-sm text-gray-400">Sin citas</p>}</div></section>}</div></div>
