@model PAW_Proyecto_Kronos.Models.UserManagementEditModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Administrar usuario";
}

<div class="max-w-2xl mx-auto"><div class="rounded-xl bg-white p-6 shadow-sm dark:bg-gray-800">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Administrar usuario</h1>
    <p class="mt-1 text-sm text-gray-500">@Model.full_name (@Model.email)</p>
    @if (ViewBag.Mensaje is string message) { <div class="mt-5 rounded-lg bg-amber-50 p-4 text-sm text-amber-800">@message</div> }
    <form asp-action="Editar" method="post" class="mt-6 space-y-5">
        <input asp-for="id" type="hidden" /><input asp-for="username" type="hidden" /><input asp-for="email" type="hidden" /><input asp-for="full_name" type="hidden" /><input asp-for="phone" type="hidden" />
        <div><label asp-for="role_id" class="block text-sm font-medium">Perfil</label><select asp-for="role_id" asp-items="@(new SelectList(Model.Roles, "id", "name"))" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900"><option value="">Selecciona un perfil</option></select><span asp-validation-for="role_id" class="text-sm text-red-600"></span></div>
        <label class="flex items-center gap-3 text-sm"><input asp-for="is_active" class="h-4 w-4" /> Usuario activo</label>
        @if (Model.requires_confirmation)
        {
            <input asp-for="confirm_pending_appointments" type="hidden" value="true" />
            <p class="text-sm text-amber-700">Al confirmar, se desactivar&aacute; el usuario aunque tiene @Model.pending_appointment_count cita(s) pendiente(s).</p>
            <button class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white">Confirmar desactivaci&oacute;n</button>
        }
        else { <button class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white">Guardar cambios</button> }
        <a asp-action="Index" class="ml-3 text-sm text-gray-600 hover:underline">Cancelar</a>
    </form>
</div></div>
