@model PAW_Proyecto_Kronos.Models.UserManagementCreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Crear usuario";
}

<div class="max-w-2xl mx-auto">
    <div class="rounded-xl bg-white p-6 shadow-sm dark:bg-gray-800">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Crear usuario</h1>
        <p class="mt-1 text-sm text-gray-500">Registra un usuario y asigna su perfil inicial.</p>

        @if (ViewBag.Mensaje is string message)
        {
            <div class="mt-5 rounded-lg bg-red-50 p-4 text-sm text-red-700">@message</div>
        }

        <form asp-action="Crear" method="post" class="mt-6 space-y-5">
            <div><label asp-for="username" class="block text-sm font-medium">Nombre de usuario</label><input asp-for="username" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900" /><span asp-validation-for="username" class="text-sm text-red-600"></span></div>
            <div><label asp-for="full_name" class="block text-sm font-medium">Nombre completo</label><input asp-for="full_name" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900" /><span asp-validation-for="full_name" class="text-sm text-red-600"></span></div>
            <div><label asp-for="email" class="block text-sm font-medium">Correo electr&oacute;nico</label><input asp-for="email" type="email" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900" /><span asp-validation-for="email" class="text-sm text-red-600"></span></div>
            <div><label asp-for="phone" class="block text-sm font-medium">Tel&eacute;fono</label><input asp-for="phone" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900" /></div>
            <p class="rounded-lg bg-blue-50 p-3 text-sm text-blue-700">El sistema generar&aacute; una contrase&ntilde;a temporal y la enviar&aacute; al correo indicado.</p>
            <div><label asp-for="role_id" class="block text-sm font-medium">Perfil</label><select asp-for="role_id" asp-items="@(new SelectList(Model.Roles, "id", "name"))" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 dark:bg-gray-900"><option value="">Selecciona un perfil</option></select><span asp-validation-for="role_id" class="text-sm text-red-600"></span></div>
            <button class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white">Crear usuario</button>
            <a asp-action="Index" class="ml-3 text-sm text-gray-600 hover:underline">Cancelar</a>
        </form>
    </div>
</div>
