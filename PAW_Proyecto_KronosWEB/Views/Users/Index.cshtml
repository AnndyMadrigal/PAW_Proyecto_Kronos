@model List<PAW_Proyecto_Kronos.Models.UserManagementListItemModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Usuarios";
}

<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Gesti&oacute;n de usuarios</h1>
            <p class="text-sm text-gray-500">Consulta y administra el perfil y estado de los usuarios.</p>
        </div>
        <a asp-action="Crear" class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white hover:bg-brand-600">Crear usuario</a>
    </div>

    @if (TempData["Mensaje"] is string message)
    {
        <div class="rounded-lg bg-green-50 p-4 text-sm text-green-700">@message</div>
    }

    <input id="userSearch" type="search" placeholder="Buscar por nombre, usuario, correo o perfil"
           class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm dark:bg-gray-800 dark:border-gray-700" />

    <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-900">
                <tr class="text-left text-xs font-medium uppercase text-gray-500">
                    <th class="px-5 py-3">Usuario</th><th class="px-5 py-3">Correo</th><th class="px-5 py-3">Perfil</th><th class="px-5 py-3">Estado</th><th class="px-5 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var user in Model)
                {
                    <tr data-user-search="@user.full_name @user.username @user.email @user.role_name" class="text-sm text-gray-700 dark:text-gray-200">
                        <td class="px-5 py-4"><div class="font-medium">@user.full_name</div><div class="text-xs text-gray-500">@user.username</div></td>
                        <td class="px-5 py-4">@user.email</td>
                        <td class="px-5 py-4">@(user.role_name ?? "Sin perfil")</td>
                        <td class="px-5 py-4"><span class="rounded-full px-2 py-1 text-xs @(user.is_active ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">@(user.is_active ? "Activo" : "Inactivo")</span></td>
                        <td class="px-5 py-4 text-right"><a asp-action="Editar" asp-route-id="@user.id" class="text-brand-600 hover:underline">Administrar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('userSearch');
        const normalize = value => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        searchInput.addEventListener('input', () => {
            const term = normalize(searchInput.value.trim());
            document.querySelectorAll('[data-user-search]').forEach(row => {
                row.classList.toggle('hidden', term && !normalize(row.dataset.userSearch).includes(term));
            });
        });
    </script>
}
