@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Servicios y atención"; }

<div class="space-y-6" x-data="servicesModule()" x-init="load()">
    <div class="flex justify-between"><div><h1 class="text-2xl font-semibold">Servicios y atención</h1><p class="text-sm text-gray-500">Administre los servicios y defina dónde se gestiona cada uno.</p></div><button @@click="openServiceForm()" class="rounded bg-brand-500 px-4 py-2 text-white">Nuevo servicio</button></div>
    <p x-show="message" class="rounded bg-red-50 p-3 text-red-700" x-text="message"></p>

    <section class="overflow-x-auto rounded-2xl border bg-white p-5"><table class="min-w-full text-sm"><thead><tr class="border-b text-left"><th class="p-2">Servicio</th><th class="p-2">Facturación</th><th class="p-2">Gestión</th><th class="p-2"></th></tr></thead><tbody><template x-for="s in items" :key="s.id"><tr class="border-b"><td class="p-2"><b x-text="s.name"></b><p class="text-xs text-gray-500" x-text="s.description || 'Sin descripción'"></p></td><td class="p-2" x-text="s.is_billable ? 'Facturable · ₡' + (s.default_price || 0) : 'No facturable'"></td><td class="p-2" x-text="managementLabel(s)"></td><td class="p-2"><div class="flex items-center justify-end gap-3 whitespace-nowrap"><button @@click="manage(s)" class="px-1 text-brand-600">Gestionar</button><button @@click="edit(s)" class="px-1">Editar</button><button @@click="remove(s.id)" class="px-1 text-red-600">Eliminar</button></div></td></tr></template></tbody></table></section>

    <div x-show="standardOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div @@click.outside="standardOpen=false" class="w-full rounded-2xl bg-white p-6">
            <div class="flex items-start justify-between gap-4"><div><h2 class="text-lg font-semibold">Registro de atención</h2><p class="mt-1 text-sm text-gray-500">Servicio: <span class="font-medium text-gray-700" x-text="selectedService?.name"></span></p></div><button @@click="standardOpen=false" class="text-xl leading-none">×</button></div>
            <form @@submit.prevent="complete()" class="mt-5 grid gap-4 md:grid-cols-2"><div><label class="mb-1 block text-sm font-medium">Cita</label><select required x-model.number="completion.service_event_id" class="w-full rounded border p-2"><option value="">Seleccione una cita pendiente</option><template x-for="eventItem in refs.events"><option :value="eventItem.id" x-text="eventItem.name"></option></template></select></div><div><label class="mb-1 block text-sm font-medium">Colaborador responsable</label><select x-model.number="completion.completed_by_staff_member_id" class="w-full rounded border p-2"><option value="">No especificado</option><template x-for="staff in refs.staff_members"><option :value="staff.id" x-text="staff.name"></option></template></select></div><div class="md:col-span-2"><label class="mb-1 block text-sm font-medium">Resumen de atención</label><textarea required x-model.trim="completion.completion_summary" placeholder="Describa la atención realizada" class="min-h-28 w-full rounded border p-2"></textarea></div><div class="flex justify-end gap-3 md:col-span-2"><button type="button" @@click="standardOpen=false" class="rounded border px-4 py-2">Cancelar</button><button class="rounded bg-emerald-600 px-4 py-2 text-white">Guardar atención</button></div></form>
        </div>
    </div>

    <div x-show="serviceFormOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div @@click.outside="serviceFormOpen=false" class="w-full rounded-2xl bg-white p-6">
            <div class="flex justify-between"><h2 class="font-semibold" x-text="form.id ? 'Editar servicio' : 'Nuevo servicio'"></h2><button @@click="serviceFormOpen=false">×</button></div>
            <form @@submit.prevent="save()" class="mt-5 grid gap-4 md:grid-cols-2"><div><label class="mb-1 block text-sm font-medium">Nombre</label><input required x-model.trim="form.name" class="w-full rounded border p-2"></div><div><label class="mb-1 block text-sm font-medium">Módulo vinculado <span class="font-normal text-gray-500">(opcional)</span></label><select x-model="form.linked_module_url" class="w-full rounded border p-2"><option value="">Sin módulo vinculado: usar formulario estándar</option><option value="/Citas">Citas y agenda</option><option value="/Expedientes">Expediente clínico</option><option value="/Inventory/Movimientos">Movimientos de inventario</option><option value="/Services/EquipmentLoans">Préstamo y alquiler de equipo</option></select></div><div class="md:col-span-2"><label class="mb-1 block text-sm font-medium">Descripción</label><input x-model.trim="form.description" class="w-full rounded border p-2"></div><div><label class="mb-1 block text-sm font-medium">Precio base</label><input type="number" min="0" step=".01" x-model.number="form.default_price" :disabled="!form.is_billable" class="w-full rounded border p-2"></div><label class="flex items-center gap-2 pt-7"><input type="checkbox" x-model="form.is_billable"> Facturable</label><div class="flex justify-end gap-2 md:col-span-2"><button type="button" @@click="serviceFormOpen=false" class="rounded border px-4 py-2">Cancelar</button><button class="rounded bg-brand-500 px-4 py-2 text-white">Guardar</button></div></form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function servicesModule() {
            const base = '@Configuration["Valores:UrlApi"]Services';
            const headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer @Context.Session.GetString("Token")' };
            const empty = () => ({ id: null, name: '', description: '', is_billable: false, default_price: null, linked_module_url: '' });
            const emptyCompletion = () => ({ service_event_id: null, completed_by_staff_member_id: null, completion_summary: '' });
            const moduleNames = { '/Citas': 'Citas y agenda', '/Expedientes': 'Expediente clínico', '/Inventory/Movimientos': 'Movimientos de inventario', '/Services/EquipmentLoans': 'Préstamo y alquiler de equipo' };
            return {
                items: [], refs: { events: [], staff_members: [] }, message: '', serviceFormOpen: false, standardOpen: false, form: empty(), completion: emptyCompletion(), selectedService: null,
                managementLabel(service) { return service.linked_module_url ? moduleNames[service.linked_module_url] || 'Módulo vinculado' : 'Formulario estándar'; },
                async load() { const [services, references] = await Promise.all([fetch(base, { headers }), fetch(base + '/CompletionReferences', { headers })]); if (services.ok) this.items = await services.json(); else this.message = await services.text(); if (references.ok) this.refs = await references.json(); },
                openServiceForm() { this.form = empty(); this.serviceFormOpen = true; },
                edit(service) { this.form = { ...empty(), ...service, linked_module_url: service.linked_module_url || '' }; this.serviceFormOpen = true; },
                manage(service) { if (service.linked_module_url) { window.location.href = service.linked_module_url; return; } this.selectedService = service; this.completion = emptyCompletion(); this.standardOpen = true; },
                async save() { const payload = { ...this.form, linked_module_url: this.form.linked_module_url || null, default_price: this.form.is_billable ? this.form.default_price : null }; const response = await fetch(this.form.id ? base + '/' + this.form.id : base, { method: this.form.id ? 'PUT' : 'POST', headers, body: JSON.stringify(payload) }); if (!response.ok) { this.message = await response.text(); return; } this.serviceFormOpen = false; await this.load(); },
                async remove(id) { if (!confirm('¿Eliminar servicio?')) return; const response = await fetch(base + '/' + id, { method: 'DELETE', headers }); if (!response.ok) this.message = await response.text(); await this.load(); },
                async complete() { const response = await fetch(base + '/Events/Complete', { method: 'POST', headers, body: JSON.stringify(this.completion) }); if (!response.ok) { this.message = await response.text(); return; } this.standardOpen = false; this.selectedService = null; await this.load(); }
            };
        }
    </script>
}
