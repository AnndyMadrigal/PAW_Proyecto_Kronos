@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Servicios y atención"; }
<div class="space-y-6" x-data="servicesModule()" x-init="load()">
 <div class="flex justify-between"><div><h1 class="text-2xl font-semibold">Servicios y atención</h1><p class="text-sm text-gray-500">Cada servicio indica dónde se gestiona su ejecución.</p></div><button @@click="open=true;reset()" class="rounded bg-brand-500 px-4 py-2 text-white">Nuevo servicio</button></div>
 <p x-show="message" class="rounded bg-red-50 p-3 text-red-700" x-text="message"></p>
 <section class="overflow-x-auto rounded-2xl border bg-white p-5"><table class="min-w-full text-sm"><thead><tr class="border-b text-left"><th class="p-2">Servicio</th><th class="p-2">Facturación</th><th class="p-2">Gestión</th><th class="p-2"></th></tr></thead><tbody><template x-for="s in items" :key="s.id"><tr class="border-b"><td class="p-2"><b x-text="s.name"></b><p class="text-xs text-gray-500" x-text="s.description||'Sin descripción'"></p></td><td class="p-2" x-text="s.is_billable?'Facturable · ₡'+(s.default_price||0):'No facturable'"></td><td class="p-2" x-text="label(s.operational_route)"></td><td class="p-2"><button @@click="go(s)" class="text-brand-600">Gestionar</button><button @@click="edit(s)" class="ml-3">Editar</button><button @@click="remove(s.id)" class="ml-3 text-red-600">Eliminar</button></td></tr></template></tbody></table></section>
 <section id="standard" class="rounded-2xl border bg-white p-5"><h2 class="font-semibold">Registro estándar de atención</h2><p class="mb-3 text-sm text-gray-500">Para servicios que no tienen módulo especializado, cierre la atención de su cita aquí.</p><form @@submit.prevent="complete()" class="grid gap-3 md:grid-cols-2"><select required x-model.number="completion.service_event_id" class="rounded border p-2"><option value="">Cita pendiente</option><template x-for="e in refs.events"><option :value="e.id" x-text="e.name"></option></template></select><select x-model.number="completion.completed_by_staff_member_id" class="rounded border p-2"><option value="">Colaborador no especificado</option><template x-for="s in refs.staff_members"><option :value="s.id" x-text="s.name"></option></template></select><textarea x-model="completion.completion_summary" placeholder="Resumen de atención" class="rounded border p-2 md:col-span-2"></textarea><button class="w-fit rounded bg-emerald-600 px-4 py-2 text-white">Completar atención</button></form></section>
 <div x-show="open" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4"><div @@click.outside="open=false" class="w-full rounded-2xl bg-white p-6"><div class="flex justify-between"><h2 class="font-semibold" x-text="form.id?'Editar servicio':'Nuevo servicio'"></h2><button @@click="open=false">×</button></div><form @@submit.prevent="save()" class="mt-5 grid gap-3 md:grid-cols-2"><input required x-model="form.name" placeholder="Nombre" class="rounded border p-2"><select x-model="form.operational_route" class="rounded border p-2"><option value="appointments">Citas y agenda</option><option value="clinical_record">Expediente clínico</option><option value="inventory">Inventario y equipos</option><option value="standard">Registro estándar</option></select><input x-model="form.description" placeholder="Descripción" class="rounded border p-2"><input type="number" min="0" step=".01" x-model.number="form.default_price" :disabled="!form.is_billable" placeholder="Precio base" class="rounded border p-2"><label class="md:col-span-2"><input type="checkbox" x-model="form.is_billable"> Facturable</label><div class="flex justify-end gap-2 md:col-span-2"><button type="button" @@click="open=false" class="rounded border px-4 py-2">Cancelar</button><button class="rounded bg-brand-500 px-4 py-2 text-white">Guardar</button></div></form></div></div>
</div>
@section Scripts {<script>function servicesModule(){const base='@Configuration["Valores:UrlApi"]Services',h={'Content-Type':'application/json','Authorization':'Bearer @Context.Session.GetString("Token")'},empty=()=>({id:null,name:'',description:'',is_billable:false,default_price:null,operational_route:'standard'}),ec=()=>({service_event_id:null,completed_by_staff_member_id:null,completion_summary:''});return{items:[],refs:{events:[],staff_members:[]},message:'',open:false,form:empty(),completion:ec(),label:r=>({appointments:'Citas y agenda',clinical_record:'Expediente clínico',inventory:'Inventario y equipos',standard:'Registro estándar'}[r]||'Registro estándar'),async load(){let[a,b]=await Promise.all([fetch(base,{headers:h}),fetch(base+'/CompletionReferences',{headers:h})]);if(a.ok)this.items=await a.json();if(b.ok)this.refs=await b.json()},reset(){this.form=empty()},edit(s){this.form={...empty(),...s};this.open=true},go(s){let u={appointments:'@Url.Action("Index","Citas")',clinical_record:'@Url.Action("Index","Expedientes")',inventory:'@Url.Action("Movimientos","Inventory")'}[s.operational_route];if(u)location.href=u;else document.getElementById('standard').scrollIntoView({behavior:'smooth'})},async save(){let r=await fetch(this.form.id?base+'/'+this.form.id:base,{method:this.form.id?'PUT':'POST',headers:h,body:JSON.stringify(this.form)});if(!r.ok){this.message=await r.text();return}this.open=false;await this.load()},async remove(id){if(confirm('¿Eliminar servicio?')){await fetch(base+'/'+id,{method:'DELETE',headers:h});await this.load()}},async complete(){let r=await fetch(base+'/Events/Complete',{method:'POST',headers:h,body:JSON.stringify(this.completion)});if(!r.ok){this.message=await r.text();return}this.completion=ec();await this.load()}}}</script>}
