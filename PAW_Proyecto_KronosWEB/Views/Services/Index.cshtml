@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Servicios y atención"; }
<div class="space-y-6" x-data="servicesModule()" x-init="load()">
 <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center"><div><h1 class="text-2xl font-semibold text-gray-800 dark:text-white">Servicios</h1><p class="mt-1 text-sm text-gray-500">Catálogo de servicios y cierre clínico-operativo de una cita.</p></div><button @@click="openForm=true; reset()" class="rounded-lg bg-brand-500 px-4 py-2 text-sm text-white">Nuevo servicio</button></div><p x-show="message" class="rounded bg-red-50 p-3 text-sm text-red-700" x-text="message"></p>
 <section class="rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[.03]"><table class="min-w-full text-sm"><thead><tr class="border-b text-left"><th class="p-2">Servicio</th><th class="p-2">Precio</th><th class="p-2">Estado</th><th class="p-2"></th></tr></thead><tbody><template x-for="s in items" :key="s.id"><tr class="border-b"><td class="p-2"><p class="font-medium" x-text="s.name"></p><p class="text-xs text-gray-500" x-text="s.description||'Sin descripción'"></p></td><td class="p-2" x-text="s.is_billable?(s.default_price??0):'No facturable'"></td><td class="p-2" x-text="s.is_active?'Activo':'Inactivo'"></td><td class="p-2"><button @@click="edit(s)" class="text-gray-600">Editar</button> <button @@click="remove(s.id)" class="text-red-600">Eliminar</button></td></tr></template></tbody></table></section>
 <section class="rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[.03]"><h2 class="text-lg font-semibold">Cerrar atención</h2><p class="mb-4 text-sm text-gray-500">Seleccione la cita y, si corresponde, a la persona colaboradora que realizó la atención.</p><form @@submit.prevent="complete()" class="grid gap-3 md:grid-cols-2"><div><label class="mb-1 block text-sm font-medium">Cita</label><select required x-model.number="completion.service_event_id" class="w-full rounded border p-2"><option value="">Seleccione una cita pendiente</option><template x-for="event in completionReferences.events" :key="event.id"><option :value="event.id" x-text="event.name"></option></template></select></div><div><label class="mb-1 block text-sm font-medium">Colaborador <span class="font-normal text-gray-500">(opcional)</span></label><select x-model.number="completion.completed_by_staff_member_id" class="w-full rounded border p-2"><option value="">No especificado</option><template x-for="staff in completionReferences.staff_members" :key="staff.id"><option :value="staff.id" x-text="staff.name"></option></template></select></div><input type="datetime-local" x-model="completion.actual_start_at" class="rounded border p-2"><input type="datetime-local" x-model="completion.actual_end_at" class="rounded border p-2"><textarea x-model="completion.completion_summary" placeholder="Resumen de la atención" class="rounded border p-2 md:col-span-2"></textarea><button class="w-fit rounded bg-emerald-600 px-4 py-2 text-white">Completar cita</button></form></section>
 <div x-show="openForm" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-gray-950/50 p-4" @@keydown.escape.window="openForm=false"><div @@click.outside="openForm=false" class="w-full max-w-xl rounded-2xl bg-white p-6 shadow-xl dark:bg-gray-900"><div class="flex justify-between"><h2 class="text-lg font-semibold dark:text-white" x-text="form.id?'Editar servicio':'Nuevo servicio'"></h2><button @@click="openForm=false" class="text-xl text-gray-500">×</button></div><form @@submit.prevent="save()" class="mt-5 grid gap-3 md:grid-cols-2"><input required x-model="form.name" placeholder="Nombre del servicio" class="rounded border p-2"><input type="number" min="0" step=".01" x-model.number="form.default_price" placeholder="Precio base" class="rounded border p-2"><input x-model="form.description" placeholder="Descripción" class="rounded border p-2"><label class="flex items-center gap-2 text-sm"><input type="checkbox" x-model="form.is_billable"> Facturable</label><div class="flex justify-end gap-2 md:col-span-2"><button type="button" @@click="openForm=false" class="rounded border px-4 py-2">Cancelar</button><button class="rounded bg-brand-500 px-4 py-2 text-white">Guardar</button></div></form></div></div>
</div>
@section Scripts {<script>function servicesModule(){const base='@Configuration["Valores:UrlApi"]Services',h={'Content-Type':'application/json','Authorization':'Bearer @Context.Session.GetString("Token")'},emptyCompletion=()=>({service_event_id:null,completed_by_staff_member_id:null,completion_summary:'',actual_start_at:'',actual_end_at:''});return{items:[],completionReferences:{events:[],staff_members:[]},message:'',openForm:false,form:{id:null,name:'',description:'',is_billable:false,default_price:null},completion:emptyCompletion(),async load(){let [s,r]=await Promise.all([fetch(base,{headers:h}),fetch(base+'/CompletionReferences',{headers:h})]);if(s.ok)this.items=await s.json();else this.message=await s.text();if(r.ok)this.completionReferences=await r.json();else this.message=await r.text()},reset(){this.form={id:null,name:'',description:'',is_billable:false,default_price:null}},edit(s){this.form={...s};this.openForm=true},async save(){let r=await fetch(this.form.id?base+'/'+this.form.id:base,{method:this.form.id?'PUT':'POST',headers:h,body:JSON.stringify(this.form)});if(!r.ok){this.message=await r.text();return}this.openForm=false;this.reset();await this.load()},async remove(id){if(!confirm('¿Eliminar este servicio?'))return;let r=await fetch(base+'/'+id,{method:'DELETE',headers:h});if(!r.ok)this.message=await r.text();await this.load()},async complete(){let p={...this.completion,completed_by_staff_member_id:this.completion.completed_by_staff_member_id||null};for(const k of ['actual_start_at','actual_end_at'])if(p[k])p[k]=new Date(p[k]).toISOString();let r=await fetch(base+'/Events/Complete',{method:'POST',headers:h,body:JSON.stringify(p)});if(!r.ok){this.message=await r.text();return}this.message='La cita fue completada correctamente.';this.completion=emptyCompletion();await this.load()}}}</script>}
