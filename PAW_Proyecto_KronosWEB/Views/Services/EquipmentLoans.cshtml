@inject IConfiguration Configuration
@{ Layout = "_Layout"; ViewData["Title"] = "Préstamo y alquiler de equipo"; }
<div class="space-y-6" x-data="equipmentLoans()" x-init="load()">
 <div><h1 class="text-2xl font-semibold">Préstamo y alquiler de equipo</h1><p class="text-sm text-gray-500">Controle quién tiene cada equipo, cuándo debe devolverlo y cuándo vuelve a estar disponible.</p></div>
 <p x-show="message" class="rounded bg-red-50 p-3 text-red-700" x-text="message"></p>
 <section class="rounded-2xl border bg-white p-6"><h2 class="mb-4 font-semibold">Entregar equipo</h2><form @@submit.prevent="save()" class="grid gap-3 md:grid-cols-2"><select required x-model.number="form.patient_id" class="rounded border p-2"><option value="">Paciente</option><template x-for="p in refs.patients"><option :value="p.id" x-text="p.name"></option></template></select><select required x-model.number="form.inventory_item_id" class="rounded border p-2"><option value="">Equipo disponible</option><template x-for="e in refs.equipment"><option :value="e.id" x-text="e.name"></option></template></select><select required x-model.number="form.location_id" class="rounded border p-2"><option value="">Ubicación</option><template x-for="l in refs.locations"><option :value="l.id" x-text="l.name"></option></template></select><select x-model="form.loan_type" class="rounded border p-2"><option value="loan">Préstamo</option><option value="rental">Alquiler</option></select><input required type="datetime-local" x-model="form.loaned_at" class="rounded border p-2"><input type="datetime-local" x-model="form.expected_return_at" class="rounded border p-2"><input min="0" step=".01" type="number" x-model.number="form.amount" placeholder="Monto (solo alquiler)" class="rounded border p-2"><input x-model="form.notes" placeholder="Observaciones de entrega" class="rounded border p-2"><div class="md:col-span-2"><button class="rounded bg-brand-500 px-4 py-2 text-white">Registrar entrega</button></div></form></section>
 <section class="overflow-x-auto rounded-2xl border bg-white p-6"><h2 class="mb-4 font-semibold">Equipos entregados</h2><table class="min-w-full text-sm"><thead><tr class="border-b text-left"><th class="p-2">Paciente</th><th class="p-2">Equipo</th><th class="p-2">Tipo</th><th class="p-2">Devolución prevista</th><th class="p-2">Estado</th><th></th></tr></thead><tbody><template x-for="x in items" :key="x.id"><tr class="border-b"><td class="p-2" x-text="x.patient_name"></td><td class="p-2"><b x-text="x.equipment_name"></b><span class="block text-xs text-gray-500" x-text="x.location_name"></span></td><td class="p-2" x-text="x.loan_type==='rental'?'Alquiler':'Préstamo'"></td><td class="p-2" x-text="x.expected_return_at?new Date(x.expected_return_at).toLocaleDateString('es-CR'):'No definida'"></td><td class="p-2" x-text="x.status==='returned'?'Devuelto':'Entregado'"></td><td class="p-2"><button x-show="x.status!=='returned'" @@click="returnItem(x.id)" class="text-emerald-600">Registrar devolución</button></td></tr></template></tbody></table></section>
</div>
@section Scripts {<script>function equipmentLoans(){const base='@Configuration["Valores:UrlApi"]Services/EquipmentLoans',h={'Content-Type':'application/json','Authorization':'Bearer @Context.Session.GetString("Token")'},empty=()=>({patient_id:null,inventory_item_id:null,location_id:null,loan_type:'loan',loaned_at:new Date().toISOString().slice(0,16),expected_return_at:'',amount:null,notes:''});return{items:[],refs:{patients:[],equipment:[],locations:[]},form:empty(),message:'',async load(){let[a,b]=await Promise.all([fetch(base,{headers:h}),fetch(base+'/References',{headers:h})]);if(a.ok)this.items=await a.json();else this.message=await a.text();if(b.ok)this.refs=await b.json()},async save(){let p={...this.form,loaned_at:new Date(this.form.loaned_at).toISOString(),expected_return_at:this.form.expected_return_at?new Date(this.form.expected_return_at).toISOString():null,amount:this.form.loan_type==='rental'?this.form.amount:null};let r=await fetch(base,{method:'POST',headers:h,body:JSON.stringify(p)});if(!r.ok){this.message=await r.text();return}this.form=empty();await this.load()},async returnItem(id){if(!confirm('¿Confirmar que el equipo fue devuelto?'))return;let r=await fetch(base+'/'+id+'/Return',{method:'POST',headers:h});if(!r.ok)this.message=await r.text();await this.load()}}}</script>}
