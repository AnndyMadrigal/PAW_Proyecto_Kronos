@inject IConfiguration Configuration
@{ Layout="_Layout"; ViewData["Title"]="Reportes operativos"; }
<div class="space-y-6" x-data="reportsModule()" x-init="load()"><div><h1 class="text-2xl font-semibold dark:text-white">Reportes operativos</h1><p class="text-sm text-gray-500">Seguimiento de citas, carga del personal y alertas de inventario.</p></div><div class="grid gap-4 sm:grid-cols-4"><template x-for="x in [{n:'Total',v:summary.total},{n:'Programadas',v:summary.scheduled},{n:'Completadas',v:summary.completed},{n:'Canceladas',v:summary.cancelled}]"><div class="rounded-xl border bg-white p-5 dark:bg-white/[.03]"><p class="text-sm text-gray-500" x-text="x.n"></p><p class="text-2xl font-semibold" x-text="x.v||0"></p></div></template></div><section class="rounded-xl border bg-white p-5 dark:bg-white/[.03]"><h2 class="mb-3 font-semibold">Carga por colaborador</h2><template x-for="w in workload"><div class="mb-2 flex justify-between border-b py-2 text-sm"><span x-text="w.staff_name"></span><b x-text="w.appointment_count+' citas'"></b></div></template></section><section class="rounded-xl border bg-white p-5 dark:bg-white/[.03]"><h2 class="mb-3 font-semibold">Stock bajo</h2><template x-for="i in lowStock"><div class="mb-2 border-b py-2 text-sm"><span x-text="i.name"></span><span class="float-right text-red-600" x-text="i.quantity_available"></span></div></template></section></div>
@section Scripts {<script>function reportsModule(){const b='@Configuration["Valores:UrlApi"]Reporting/',h={'Authorization':'Bearer @Context.Session.GetString("Token")'};return{summary:{},workload:[],lowStock:[],async load(){let [a,w,l]=await Promise.all([fetch(b+'Appointments/Summary',{headers:h}),fetch(b+'Appointments/Workload',{headers:h}),fetch(b+'Inventory/LowStock',{headers:h})]);if(a.ok)this.summary=await a.json();if(w.ok)this.workload=await w.json();if(l.ok)this.lowStock=await l.json()}}}</script>}
